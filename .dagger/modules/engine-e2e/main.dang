"""
Checks the Python SDK against a development engine from dagger main, pinned by commit.
Keep engineCommit and the engine-dev dependency in dagger-module.toml aligned.
"""
type EngineE2e {
  let engineCommit: String! = "284cd849d39a66ee2da8c9800aa4f791844770f0"
  let modulePath: String! = ".dagger/modules/sdk-smoke"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  v1.0.0-beta.13, the pin before this one, which reverting the pin commit
  restores. It predates serveModule, so there a client loads its module
  through the SDK's fallback; every later pin has the field.
  """
  let beta13Commit: String! = "6bf59d50654ce9244ebeee1cc090b7dce3fe3083"

  """
  The pinned main engine should list this checkout as the python SDK,
  initialize a Python module from it, and run the module.
  """
  pub devSdkCheck(ws: Workspace!): Void @check {
    let listed = playground(ws).withExec(["dagger", "sdk", "list"])
    assert(listed.stdout.contains("python"), "the development Python SDK was not listed")

    let checked = listed.withExec(["dagger", "check"])

    let initialized = checked
      .withExec(["dagger", "module", "init", "python", "--auto-apply", "--name", "sdk-smoke", "--path", modulePath])
      .withExec(["test", "-f", modulePath + "/dagger-module.toml"])
      .withExec(["test", "!", "-e", modulePath + "/dagger.json"])
      .withExec(["test", "-f", modulePath + "/pyproject.toml"])
      .withExec(["test", "-f", modulePath + "/src/sdk_smoke/__init__.py"])
      .withExec(["test", "-f", modulePath + "/sdk/pyproject.toml"])
      .withExec(["test", "-f", modulePath + "/clients/core/src/dagger_clients/core/__init__.py"])
      .withExec(["test", "!", "-e", modulePath + "/sdk/src/dagger/client/gen.py"])

    let release = initialized
      .withExec(["dagger", "-m", modulePath, "call", "container", "file", "--path", "/etc/alpine-release", "contents"])
      .stdout
    assert(release.trimSpace != "", "the generated module did not run")

    initialized
      .withExec([
        "dagger", "module", "init", "python", "--auto-apply",
        "--name", "sdk-settings",
        "--path", ".dagger/modules/sdk-settings",
        "--template", "empty",
        "--python-version", "3.13",
        "--use-uv=false",
        "--base-image", "python:3.13-slim",
      ])
      .withExec(["grep", "-q", "class SdkSettings:", ".dagger/modules/sdk-settings/src/sdk_settings/__init__.py"])
      .withExec(["grep", "-q", ">=3.13", ".dagger/modules/sdk-settings/pyproject.toml"])
      .withExec(["grep", "-q", "use-uv = false", ".dagger/modules/sdk-settings/pyproject.toml"])
      .withExec(["grep", "-q", "python:3.13-slim", ".dagger/modules/sdk-settings/pyproject.toml"])

    null
  }

  """
  A module calls the client it declared: `dagger module client add`
  generates the client into the module's scope, and the module's code
  imports it and calls the client's module. On the pinned engine that is
  through serveModule; on beta.13, through the SDK's fallback.
  """
  pub devClientCallCheck(ws: Workspace!): Void @check {
    let path = ".dagger/modules/sdk-client-call"
    let source =
      "from dagger import function, object_type\n" +
      "from dagger_clients.client_dep import client_dep\n\n\n" +
      "@object_type\n" +
      "class SdkClientCall:\n" +
      "    @function\n" +
      "    async def greeting(self) -> str:\n" +
      "        return await client_dep().greeting()\n"
    # The runtime of this checkout, not the published shared entrypoint, which
    # builds the layout before.
    let manifest = "name = \"sdk-client-call\"\nengineVersion = \"v1.0.0-0\"\n\n[runtime]\nsource = \"../../../runtime\"\n"

    let client = playground(ws)
    # A pass must prove the path it claims: the field on an engine that has
    # it, not the SDK's fallback standing in for it.
    let fields = client
      .withExec(["dagger", "query"], stdin: "{ __type(name: \"Query\") { fields { name } } }")
      .stdout
    if (engineCommit == beta13Commit) {
      assert(fields.contains("\"serveModule\"") == false, "beta.13 has serveModule after all, so this check would not prove the fallback")
    } else {
      assert(fields.contains("\"serveModule\""), "the dev engine has no serveModule, so this check would prove only the fallback")
    }

    let called = client
      .withExec(["dagger", "module", "init", "python", "--auto-apply", "--name", "sdk-client-call", "--path", path])
      .withWorkdir(path)
      .withExec(["dagger", "module", "client", "add", "../e2e/fixtures/clients/dep", "--sdk", "python", "--auto-apply"])
      .withExec(["test", "-f", "clients/client-dep/src/dagger_clients/client_dep/_target.py"])
      .withNewFile("src/sdk_client_call/__init__.py", source)
      .withNewFile("dagger-module.toml", manifest)
      .withExec(["dagger", "-m", ".", "call", "greeting"])
      .stdout
    assert(called.contains("hello from the client dependency"), "the module did not call its client: " + called)

    null
  }

  """
  This checkout, registered to the SDK the way the e2e workspace registers
  it, inside a playground of the pinned development engine.
  """
  let playground(ws: Workspace!): Container! {
    let sdkSource = ws.directory("/", exclude: [".git", ".remember", "**/.venv", "**/__pycache__", ".dagger/modules/e2e/out"])
      .withFile("dagger.toml", ws.file("/.dagger/modules/engine-e2e/workspace.toml"))
    let engineSource = git("https://github.com/dagger/dagger")
      .ref(engineCommit)
      .asWorkspace
    # installClient rather than playground, which engine-dev dropped after
    # beta.13; both pins have it. The checks need git, which its default
    # client lacks.
    engineDev(ws: engineSource)
      .installClient(client: container.from("alpine:3.22").withExec(["apk", "add", "--no-cache", "git"]))
      .withMountedDirectory("/work/python-sdk", sdkSource)
      .withWorkdir("/work/python-sdk")
      .withExec(["git", "init", "--quiet"])
  }
}
