"""
End-to-end checks for the Python SDK helper module.
"""
type E2e {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let outputRoot: String! = ".dagger/modules/e2e/out"

  let lookupModulePath: String! = fixtureRoot + "/lookup/app"
  let lookupNestedPath: String! = lookupModulePath + "/nested"
  let nonPythonModulePath: String! = fixtureRoot + "/lookup/not-python"
  let generateModulePath: String! = fixtureRoot + "/generate/app"
  let configModulePath: String! = fixtureRoot + "/config/app"
  let configuredModulePath: String! = fixtureRoot + "/config/configured"
  let tomlModulePath: String! = fixtureRoot + "/toml/app"
  let runtimeModulePath: String! = fixtureRoot + "/runtime/app"
  let tomlGenerateModulePath: String! = fixtureRoot + "/toml-generate/app"
  let clientDepPath: String! = fixtureRoot + "/clients/dep"
  let legacyClientDepPath: String! = fixtureRoot + "/clients/legacy"
  let staleEntrypointPath: String! = fixtureRoot + "/stale-entrypoint"
  let otherRefusalPath: String! = fixtureRoot + "/other-refusal"
  let plainScopePath: String! = fixtureRoot + "/plain"
  let markerTextPath: String! = fixtureRoot + "/lookup/marker-text"
  let staticTypesModulePath: String! = fixtureRoot + "/static-types"
  let runtimeGreeting: String! = "served by the python-sdk runtime"
  let mixedDiscoveryModulePath: String! = fixtureRoot + "/mixed-discovery/ancestor/work/app"
  let mixedDiscoveryNestedPath: String! = mixedDiscoveryModulePath + "/nested/deeper"

  let legacyBindingsPath: String! = "sdk/src/dagger/client/gen.py"
  let generatedMarkerContents: String! = "Code generated by dagger."
  let sdkMemberFile: String! = "sdk/pyproject.toml"
  let coreMemberFile: String! = "clients/core/pyproject.toml"
  let coreInitPath: String! = "clients/core/src/dagger_clients/core/__init__.py"
  let clientDepMember: String! = "clients/client-dep"
  let clientDepTargetPath: String! = clientDepMember + "/src/dagger_clients/client_dep/_target.py"
  let globalPackage: String! = "dagger_global"

  """
  The tree every generated scope has, module or not: the SDK files with no
  generated code in them, and core, each a member marked as the SDK's.
  """
  let assertScopeTree(generated: Workspace!, scope: String!): Void {
    let root = generated.directory("/" + scope)
    assertContains(root.file(sdkMemberFile).contents, "generated = \"runtime\"", scope + ": sdk/ is not marked as the SDK's member")
    assert(root.exists("sdk/src/dagger/__init__.py"), scope + ": sdk/ lacks the SDK files")
    assert(root.exists(legacyBindingsPath) == false, scope + ": sdk/ still holds generated bindings")
    assertContains(root.file(coreMemberFile).contents, "generated = \"core\"", scope + ": clients/core is not marked as core")
    assertContains(root.file(coreInitPath).contents, generatedMarkerContents, scope + ": core was not generated")
    let scopeFile = root.file("pyproject.toml").contents
    assertContainsAll(scopeFile, [
      "[tool.uv.workspace]",
      "\"sdk\"",
      "\"clients/core\"",
      "dagger-io = { workspace = true }",
      "dagger-clients-core = { workspace = true }",
    ])
    null
  }

  let coreDigestOf(generated: Workspace!, scope: String!): String! {
    let m = generated.file("/" + scope + "/" + coreInitPath).contents.match("(?m)^CORE_DIGEST = \"([^\"]*)\"")
    if (m == null) { raise scope + ": core carries no CORE_DIGEST" } else { m.captures[0] ?? "" }
  }

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  let contains(values: [String!]!, want: String!): Boolean! {
    values
      .filter { value => value == want }
      .length > 0
  }

  let assertAdded(changes: Changeset!, path: String!): Void {
    assert(contains(changes.addedPaths, path), "expected added path: " + path)
  }

  let assertNoneAdded(changes: Changeset!, paths: [String!]!, what: String!): Void {
    let reAdded = paths.filter { path => contains(changes.addedPaths, path) }
    assert(
      reAdded.length == 0,
      what + " re-added files that already exist: " + reAdded.join(", "),
    )
  }

  let assertContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want), message)
  }

  let assertNotContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want) == false, message)
  }

  let assertContainsAll(value: String!, wants: [String!]!): Void {
    wants.each { want =>
      assertContains(value, want, "expected value to contain: " + want)
    }
    null
  }

  let assertContainsNone(value: String!, unwanted: [String!]!): Void {
    unwanted.each { want =>
      assertNotContains(value, want, "expected value not to contain: " + want)
    }
    null
  }

  """
  Mod lookup should find the owning Python SDK module when called from a nested path.
  """
  pub moduleLookupCheck(scope: Workspace!): Void @check {
    let ws = withScope(scope, lookupModulePath, "lookup-app")
    let nested = pythonSdk.mod(ws, path: lookupNestedPath)
    let exact = pythonSdk.mod(ws, path: lookupModulePath, findUp: false)

    assert(nested.rootPath == lookupModulePath, "find-up lookup returned the wrong module path")
    assert(exact.rootPath == lookupModulePath, "exact lookup returned the wrong module path")

    null
  }

  """
  Lookup should refuse a module this SDK does not manage, rather than handing
  back a Mod for someone else's module.
  """
  pub unmanagedLookupCheck(ws: Workspace!): Void @check {
    let found = pythonSdk.mod(ws, path: nonPythonModulePath).rootPath rescue "raised"

    assert(found == "raised", "lookup returned a module this SDK does not manage: " + found)

    null
  }

  """
  Lookup must choose the nearest registered module even when an ancestor holds
  a module config of the other format.
  """
  pub mixedConfigLookupCheck(scope: Workspace!): Void @check {
    let ws = withScope(withScope(scope, mixedDiscoveryModulePath, "mixed-discovery-app"), tomlModulePath, "toml-app")
    let mixed = pythonSdk.mod(ws, path: mixedDiscoveryNestedPath)
    assert(mixed.rootPath == mixedDiscoveryModulePath, "lookup chose the ancestor dagger-module.toml instead of the nearer registered module")

    let toml = pythonSdk.mod(ws, path: tomlModulePath + "/nested")
    assert(toml.rootPath == tomlModulePath, "lookup from inside a registered dagger-module.toml module returned the wrong root")
    null
  }

  """
  findClientRoot answers with the directory of the nearest pyproject.toml as a
  workspace-root-relative path, with the scope rather than one of its
  generated members, with the module rather than its vendored client library
  from before the marker, and with null where there is none.
  """
  pub findClientRootCheck(ws: Workspace!): Void @check {
    assert(pythonSdk.findClientRoot(ws.withWorkdir(lookupNestedPath)) == lookupModulePath, "findClientRoot should find the module owning a nested path")
    assert(pythonSdk.findClientRoot(ws.withWorkdir(lookupModulePath)) == lookupModulePath, "findClientRoot should answer with the module root itself")
    assert(pythonSdk.findClientRoot(ws.withWorkdir(runtimeModulePath + "/sdk/src/dagger/client")) == runtimeModulePath, "findClientRoot should answer with the module owning a vendored sdk/, not the sdk/ itself")
    assert(pythonSdk.findClientRoot(ws.withWorkdir("sdk/src/dagger/client")) == "sdk", "findClientRoot should not lift a standalone sdk/ project into a parent that is not a Python module")

    let nestedSdkWs = ws.withNewFile("/" + runtimeModulePath + "/sdk/dagger-module.toml", "name = \"nested\"\n\n[runtime]\nsource = \"python\"\n")
    assert(pythonSdk.findClientRoot(nestedSdkWs.withWorkdir(runtimeModulePath + "/sdk/src/dagger/client")) == runtimeModulePath + "/sdk", "findClientRoot should answer with a nested module named sdk, not lift it into its parent")
    assert(pythonSdk.findClientRoot(ws) == null, "findClientRoot should return null when it finds no client root")

    # A generated member lifts to its scope: the marker tells, not the name.
    # The members are fixtures on disk, because findUp does not see files
    # added to the workspace.
    assert(pythonSdk.findClientRoot(ws.withWorkdir(lookupModulePath + "/clients/linter")) == lookupModulePath, "findClientRoot should lift a generated client to its scope")
    assert(pythonSdk.findClientRoot(ws.withWorkdir(lookupModulePath + "/sdk")) == lookupModulePath, "findClientRoot should lift a marked sdk/ to its scope")
    assert(pythonSdk.findClientRoot(ws.withWorkdir(plainScopePath + "/clients/core")) == plainScopePath, "findClientRoot should lift core to a scope without a module")
    # The marker is read as TOML: the same text inside a multi-line string is
    # no marker, so the project answers for itself.
    assert(pythonSdk.findClientRoot(ws.withWorkdir(markerTextPath + "/notes")) == markerTextPath + "/notes", "findClientRoot lifted a project whose marker is only text in a string")

    null
  }


  """
  generateScope initializes a module that has no config: the template, a
  dagger-module.toml from the manifest builder and no dagger.json, and the
  scope tree, all under the scope, with the workspace cwd and existing files
  untouched. A new module imports core from dagger_clients and gets no global
  client. SDK settings select the template and its pyproject.toml values.
  """
  pub generateScopeInitCheck(ws: Workspace!): Void @check {
    let scope = outputRoot + "/scope-init"
    let scoped = ws
      .withNewDirectory("/" + scope, directory)
      .withNewFile("/" + scope + "/keep.txt", "keep\n")
      .withWorkdir(scope)
    let generated = pythonSdk.generateScope(scoped, isModule: true, name: "scope-init", clients: [])
    let changes = generated.withWorkdir(".").changes(scoped.withWorkdir("."))

    assert(generated.cwd == scoped.cwd, "generateScope must not change the workspace cwd")
    assertAdded(changes, scope + "/dagger-module.toml")
    assert(contains(changes.addedPaths, scope + "/dagger.json") == false, "initializing a scope must not write a dagger.json")
    assertAdded(changes, scope + "/pyproject.toml")
    assertAdded(changes, scope + "/src/scope_init/__init__.py")
    assertAdded(changes, scope + "/" + sdkMemberFile)
    assertAdded(changes, scope + "/" + coreInitPath)
    assertScopeTree(generated.withWorkdir("."), scope)
    assert(changes.modifiedPaths.length == 0, "initializing a scope modified existing files: " + changes.modifiedPaths.join(", "))
    assert(changes.removedPaths.length == 0, "initializing a scope removed existing files: " + changes.removedPaths.join(", "))
    let manifest = changes.layer.file(scope + "/dagger-module.toml").contents
    assertContainsAll(manifest, [
      "name = \"scope-init\"",
      "[entrypoint]",
      "kind = \"dang\"",
      "source = \"./sdk/entrypoint\"",
    ])
    ["main.dang", "types.dang", "build.dang"].each { file => assertAdded(changes, scope + "/sdk/entrypoint/" + file) }
    # The entrypoint runs the module, on the engine's own version.
    assertContainsNone(manifest, ["[runtime]", "engineVersion", "[[dependencies]]"])
    let defaultSource = changes.layer.file(scope + "/src/scope_init/__init__.py").contents
    assertContainsAll(defaultSource, [
      "class ScopeInit:",
      "from dagger_clients.core import",
      "ws: Workspace",
      "def container(self) -> Container:",
      "core()",
    ])
    assertContainsNone(defaultSource, ["def __init__", "{{", "dag."])
    let defaultPyproject = changes.layer.file(scope + "/pyproject.toml").contents
    assertContains(defaultPyproject, ">=3.14", "default settings should keep the template python version")
    assertNotContains(defaultPyproject, "[tool.dagger]", "a new module should get no [tool.dagger] table, so no global client")
    assertContains(defaultPyproject, "\"dagger-clients-core\"", "a new module should depend on core")
    assert(generated.directory("/" + scope).exists("sdk/src/" + globalPackage) == false, "a new module got the global client")

    let configuredScope = outputRoot + "/scope-init-configured"
    let configuredScoped = ws.withNewDirectory("/" + configuredScope, directory).withWorkdir(configuredScope)
    let configuredChanges = pythonSdk(template: "empty", pythonVersion: "3.13", useUv: false, baseImage: "python:3.13-slim")
      .generateScope(configuredScoped, isModule: true, name: "scope-init-configured", clients: [])
      .withWorkdir(".")
      .changes(ws)
    assertContainsAll(configuredChanges.layer.file(configuredScope + "/src/scope_init_configured/__init__.py").contents, ["class ScopeInitConfigured:", "    pass"])
    assertContainsAll(configuredChanges.layer.file(configuredScope + "/pyproject.toml").contents, [
      ">=3.13",
      "use-uv = false",
      "python:3.13-slim",
      "dagger-io",
      "dagger-clients-core",
      "workspace = true",
    ])
    assertNotContains(configuredChanges.layer.file(configuredScope + "/pyproject.toml").contents, "global-client", "a new module got the global client")

    null
  }

  """
  generateScope preserves a current manifest. It migrates a pre-1.0
  dagger.json to dagger-module.toml. Both cases get the scope tree, and the
  vendored source of the layout before it becomes a workspace source.
  """
  pub generateScopeExistingCheck(ws: Workspace!): Void @check {
    let currentWs = pythonSdk
      .generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    let current = currentWs.changes(ws)
    assertAdded(current, tomlGenerateModulePath + "/" + sdkMemberFile)
    assertScopeTree(currentWs, tomlGenerateModulePath)
    let currentManifest = current.after.file(tomlGenerateModulePath + "/dagger-module.toml").contents
    assertContains(currentManifest, "source = \"./sdk/entrypoint\"", "regenerating did not move the module onto an entrypoint of its own")
    assertContainsNone(currentManifest, ["[runtime]", "engineVersion"])
    assertNotContains(current.after.file(tomlGenerateModulePath + "/pyproject.toml").contents, "path = \"sdk\"", "the vendored source survived")

    # The runtime reads the members as TOML defines them, so a quoted header,
    # valid TOML, generates, and the runtime reads the members it lists. The
    # input is a scope generation wrote, with only its header rewritten.
    let pyprojectPath = "/" + tomlGenerateModulePath + "/pyproject.toml"
    let written = currentWs.file(pyprojectPath).contents
    assert(written.contains("\n[tool.uv.workspace]\n"), "generation wrote no [tool.uv.workspace] header to rewrite")
    let quotedToml = written.replace("[tool.uv.workspace]", "[\"tool\".\"uv\".\"workspace\"]")
    let quoted = pythonSdk
      .generateScope(currentWs.withNewFile(pyprojectPath, quotedToml).withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    let quotedRead = pythonSdkRuntime.scopeMembers(quoted.file(pyprojectPath))
    assert(quotedRead.filter { m => m == "sdk" or m == "clients/core" }.length == 2, "the runtime did not read the members under a quoted header: " + quotedRead.join(", "))

    # Nor a member the runtime would read and uv would not: a nested array is
    # no member, so the runtime refuses to read it rather than flatten it,
    # and generation refuses the file.
    let nestedToml = written.replace("\"clients/core\"]", "\"clients/core\", [\"clients/unowned\"]]")
    assert(nestedToml != written, "generation wrote no members array to nest into")
    let runtimeRead = pythonSdkRuntime.scopeMembers(directory.withNewFile("pyproject.toml", nestedToml).file("pyproject.toml")) rescue {
      err: Error => ["refused"]
    }
    assert(runtimeRead == ["refused"], "the runtime read a nested members array as " + runtimeRead.join(", "))
    let nested = pythonSdk
      .generateScope(currentWs.withNewFile(pyprojectPath, nestedToml).withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .cwd rescue {
        err: Error => err.message
      }
    assertContainsAll(nested, ["the module runtime cannot read: members is not an array of strings", "Write members as an array of strings, not a nested array", "then run dagger generate again"])
    # The members it lists are fine; naming them would point away from the cause.
    assertNotContains(nested, "misses", "the refusal listed the members the runtime did not get to read")

    let legacyWs = pythonSdk
      .generateScope(ws.withWorkdir(generateModulePath), isModule: true, name: "generate-app", clients: [])
      .withWorkdir(".")
    let legacy = legacyWs.changes(ws)
    assertScopeTree(legacyWs, generateModulePath)
    assertAdded(legacy, generateModulePath + "/dagger-module.toml")
    assert(contains(legacy.removedPaths, generateModulePath + "/dagger.json"), "migration did not remove dagger.json")
    let legacyManifest = legacy.after.file(generateModulePath + "/dagger-module.toml").contents
    assertContainsAll(legacyManifest, [
      "name = \"generate-app\"",
      "source = \"./sdk/entrypoint\"",
    ])
    assertContainsNone(legacyManifest, ["[runtime]", "engineVersion"])

    null
  }

  """
  A client is a member of the scope that declares it: adding one writes
  exactly its member, its source, its `members` entry and its dependency, and
  removing it undoes all four. The member loads its module by the path from
  the workspace root and was generated against the scope's core. No client
  reaches the manifest, and the [[dependencies]] of the layout before go.
  """
  pub generateScopeClientsCheck(ws: Workspace!): Void @check {
    let manifestPath = "/" + tomlGenerateModulePath + "/dagger-module.toml"
    let scopeFilePath = "/" + tomlGenerateModulePath + "/pyproject.toml"
    let member = "/" + tomlGenerateModulePath + "/" + clientDepMember
    let client = ws.moduleSource("/" + clientDepPath)
    # The manifest is written whole, naming no runtime: a module the builtin
    # runtime ran gets the global client, which moves with every client added.
    let seeded = ws.withNewFile(manifestPath, "name = \"toml-generate-app\"\n" +
      "\n[[dependencies]]\nname = \"client-dep\"\nsource = \"../../clients/dep\"\n")
    let without = pythonSdk
      .generateScope(seeded.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assertNotContains(without.file(manifestPath).contents, "[[dependencies]]", "generation kept the [[dependencies]] of the layout before")

    let with = pythonSdk
      .generateScope(without.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [client])
      .withWorkdir(".")
    let added = with.changes(without)
    assertScopeTree(with, tomlGenerateModulePath)
    assert(added.modifiedPaths.length == 1 and contains(added.modifiedPaths, tomlGenerateModulePath + "/pyproject.toml"), "adding a client modified more than the scope file: " + added.modifiedPaths.join(", "))
    assert(added.removedPaths.length == 0, "adding a client removed files: " + added.removedPaths.join(", "))
    assert(added.addedPaths.filter { path => path.hasPrefix(tomlGenerateModulePath + "/" + clientDepMember + "/") == false }.length == 0, "adding a client added files outside its member")
    assertNotContains(with.file(manifestPath).contents, "client-dep", "a client reached the manifest")

    let memberFile = with.file(member + "/pyproject.toml").contents
    assertContainsAll(memberFile, ["name = \"dagger-clients-client-dep\"", "generated = \"client\"", "module-name = \"dagger_clients.client_dep\""])
    let target = with.file("/" + tomlGenerateModulePath + "/" + clientDepTargetPath).contents
    assertContainsAll(target, [
      "NAME = \"client-dep\"",
      "REF = \"" + clientRef(client, clientDepPath) + "\"",
      "PIN = " + clientPin(client),
      "CORE_DIGEST = \"" + coreDigestOf(with, tomlGenerateModulePath) + "\"",
    ])
    assertContains(with.file(member + "/src/dagger_clients/client_dep/__init__.py").contents, "def client_dep(", "the client has no entry function")

    let scopeDiff = with.file(scopeFilePath).contents
    assertContainsAll(scopeDiff, [
      "\"clients/client-dep\"",
      "dagger-clients-client-dep = { workspace = true }",
      "\"dagger-clients-client-dep\"",
    ])

    let removed = pythonSdk
      .generateScope(with.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assert(removed.changes(without).isEmpty, "removing the client did not undo adding it")

    null
  }

  """
  A client whose target refuses to load with the advice of an SDK older than
  this layout: generation says which client cannot load, that `dagger
  generate` cannot help, and the two ways out. Another refusal from the same
  place keeps its own words.
  """
  pub generateScopeStaleTargetCheck(ws: Workspace!): Void @check {
    let scoped = ws.withWorkdir(tomlGenerateModulePath)
    let stale = pythonSdk
      .generateScope(scoped, isModule: true, name: "toml-generate-app", clients: [ws.moduleSource("/" + staleEntrypointPath)])
      .file("/" + tomlGenerateModulePath + "/clients/stale-entrypoint-target/pyproject.toml")
      .contents rescue {
        err: Error => err.message
      }
    assertContainsAll(stale, [
      "the client \"stale-entrypoint-target\" cannot be loaded",
      "its entrypoint \"./entrypoint\" is older than this SDK",
      "[entrypoint] source",
    ])

    let other = pythonSdk
      .generateScope(scoped, isModule: true, name: "toml-generate-app", clients: [ws.moduleSource("/" + otherRefusalPath)])
      .file("/" + tomlGenerateModulePath + "/clients/other-refusal-target/pyproject.toml")
      .contents rescue {
        err: Error => err.message
      }
    assertContains(other, "generated file \"src/dagger_gen.py\" is missing; run `dagger generate` and commit the generated files", "another refusal did not pass through: " + other)
    assertNotContains(other, "cannot be loaded", "another refusal was rewritten: " + other)

    null
  }

  """
  A Git client's descriptor always carries the commit its ref resolved to,
  and a newly resolved commit replaces it, as `dagger module client update`
  does. The client never reaches the manifest, and JSON is removed.
  """
  pub generateScopePinsCheck(ws: Workspace!): Void @check {
    let commit = "64645f1967d3dba6fce951dd61ae4acd8d9b0861"
    let updatedCommit = "92d07fcb9dd25ae50afd30097f09936d674c2950"
    let target = moduleSource("github.com/dagger/sdk-helpers@main", refPin: commit)
    let updated = moduleSource("github.com/dagger/sdk-helpers@main", refPin: updatedCommit)
    let descriptor = "clients/sdk-helpers/src/dagger_clients/sdk_helpers/_target.py"
    let input = ws.withWorkdir(tomlGenerateModulePath).withNewFile("keep.txt", "keep")
    let pinned = pythonSdk.generateScope(input, isModule: true, name: "toml-generate-app", clients: [target])
    assertContainsAll(pinned.file(descriptor).contents, ["REF = \"" + target.asString + "\"", "PIN = \"" + commit + "\""])
    assertNotContains(pinned.file("dagger-module.toml").contents, "sdk-helpers", "a client reached the manifest")
    let repinned = pythonSdk.generateScope(pinned.withNewFile("dagger.json", "stale"), isModule: true, name: "toml-generate-app", clients: [updated])
    assertContains(repinned.file(descriptor).contents, "PIN = \"" + updatedCommit + "\"", "a newly resolved commit did not replace the pin")
    assert(!repinned.directory(".").exists("dagger.json"), "generation retained JSON")
    assert(repinned.cwd == input.cwd, "generation changed cwd")
    assert(repinned.file("keep.txt").contents == "keep", "generation changed another file")
    assertNotContains(repinned.file("dagger-module.toml").contents, "engineVersion", "an entrypoint manifest kept the engine version only a runtime reads")
    let repeated = pythonSdk.generateScope(repinned, isModule: true, name: "toml-generate-app", clients: [updated])
    assert(repeated.changes(repinned).isEmpty, "repeated generation changed the workspace")
    null
  }

  """
  Core is read in the view the module's session runs in, and every client is
  read in the same view. On an entrypoint that is the engine's own version,
  whatever engineVersion the runtime manifest before it declared. A module
  that keeps a runtime of its own runs in the view it declares, and so does
  its core.

  Not covered yet: a client in a module older than v1.0.0. That view names
  each module type's ID scalar and loader with no @sourceMap, so the
  generator counts them as core and refuses the client as skew.
  """
  pub generateScopeViewCheck(ws: Workspace!): Void @check {
    let manifestPath = "/" + tomlGenerateModulePath + "/dagger-module.toml"
    let older = "name = \"toml-generate-app\"\nengineVersion = \"v0.21.9\"\n\n[runtime]\nsource = "
    let migrated = pythonSdk
      .generateScope(ws.withNewFile(manifestPath, older + "\"python\"\n").withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    let own = pythonSdk
      .generateScope(ws.withNewFile(manifestPath, older + "\"../../../../../../runtime\"\n").withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    # Workspace.cwd is newer than v0.21.9.
    assertContains(migrated.file("/" + tomlGenerateModulePath + "/" + coreInitPath).contents, "def cwd(", "a module moved onto the entrypoint kept the view of its runtime")
    assertNotContains(own.file("/" + tomlGenerateModulePath + "/" + coreInitPath).contents, "def cwd(", "core was not generated in the view of the module's own runtime")

    # The version a pre-1.0 config declared outlives `dagger module migrate`,
    # in the manifest it writes. A module generated on its own reads the
    # manifest as it stands, so it must still take the engine's view: the
    # builtin runtime is the one this SDK takes over.
    let stale = ws.withNewFile(manifestPath, older + "\"python\"\n")
    let direct = stale.withChanges(pythonSdk.mod(stale, path: tomlGenerateModulePath, findUp: false).generate)
    assertContains(direct.file("/" + tomlGenerateModulePath + "/" + coreInitPath).contents, "def cwd(", "generating a module on its own kept the view its migrated manifest declares")

    # Nor does a module that keeps the builtin runtime because of what only a
    # runtime can honour: it runs on the engine's version like the rest.
    let keptPath = "name = \"toml-generate-app\"\nengineVersion = \"v0.21.9\"\ninclude = [\"src\"]\n\n[runtime]\nsource = \"python\"\n"
    let kept = pythonSdk
      .generateScope(ws.withNewFile(manifestPath, keptPath).withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assertContains(kept.file("/" + tomlGenerateModulePath + "/" + coreInitPath).contents, "def cwd(", "a module kept on the builtin runtime generated in the view its manifest declares")
    # And the manifest it moves to says the same version, so the module's calls
    # run in the view its bindings were generated in.
    let keptManifest = kept.file(manifestPath).contents
    assertContains(keptManifest, "source = \"" + sdkRuntimeSource + "\"", "the module was left on the builtin runtime: " + keptManifest)
    assertNotContains(keptManifest, "v0.21.9", "the version the pre-1.0 config declared survived the move: " + keptManifest)

    null
  }

  """
  A module whose code is the code of the layout before gets the temporary
  global client once, told by its bindings or by the runtime its manifest
  names: the flag is written, dagger_global joins the SDK files, which then
  depend on core and each client, and the old bindings go. A scope file that
  turns the flag off keeps it off. Turning the flag off with `mod config set`
  removes the global client at the next generation.
  """
  pub generateScopeGlobalClientCheck(ws: Workspace!): Void @check {
    let root = "/" + runtimeModulePath
    let client = ws.moduleSource("/" + clientDepPath)
    let upgraded = pythonSdk
      .generateScope(ws.withWorkdir(runtimeModulePath), isModule: true, name: "runtime-app", clients: [client])
      .withWorkdir(".")
    assertContains(upgraded.file(root + "/pyproject.toml").contents, "global-client = true", "an upgraded module did not get the flag")
    assert(upgraded.directory(root).exists(legacyBindingsPath) == false, "the bindings of the layout before survived the upgrade")
    assertContains(upgraded.file(root + "/sdk/src/" + globalPackage + "/__init__.py").contents, "class Client(", "the global client was not generated")
    assertContainsAll(upgraded.file(root + "/" + sdkMemberFile).contents, [
      "module-name = [\"dagger\", \"dagger_global\"]",
      "\"dagger-clients-core\",",
      "\"dagger-clients-client-dep\",",
    ])

    let again = pythonSdk
      .generateScope(upgraded.withWorkdir(runtimeModulePath), isModule: true, name: "runtime-app", clients: [client])
      .withWorkdir(".")
    assert(again.changes(upgraded).isEmpty, "a second generation changed an upgraded module")

    let off = upgraded.withChanges(pythonSdk.mod(upgraded, path: runtimeModulePath, findUp: false).config.set(globalClient: false))
    assertNotContains(off.file(root + "/pyproject.toml").contents, "global-client", "mod config set left the flag")
    let without = pythonSdk
      .generateScope(off.withWorkdir(runtimeModulePath), isModule: true, name: "runtime-app", clients: [client])
      .withWorkdir(".")
    assert(without.directory(root).exists("sdk/src/" + globalPackage) == false, "turning the flag off kept the global client")
    let sdkFile = without.file(root + "/" + sdkMemberFile).contents
    assertContains(sdkFile, "module-name = \"dagger\"", "turning the flag off kept dagger_global in the SDK files")
    assertNotContains(sdkFile, "dagger-clients-client-dep", "turning the flag off kept the SDK files' dependency on the client")
    assertNotContains(without.file(root + "/pyproject.toml").contents, "global-client", "generation wrote the flag again")

    # A module on a published dagger-io kept its generated bindings next to
    # its code. They go with the upgrade, since the SDK files no longer read
    # them; a hand-written file of that name is the user's and stays.
    let published = "/" + tomlGenerateModulePath
    let userBindings = ws.withNewFile(published + "/src/dagger_gen.py", "# Code generated by dagger. DO NOT EDIT.\n")
    let onPublished = pythonSdk
      .generateScope(userBindings.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assertContains(onPublished.file(published + "/pyproject.toml").contents, "global-client = true", "a module with src/dagger_gen.py was not upgraded")
    assert(onPublished.directory(published).exists("sdk/src/" + globalPackage), "a module with src/dagger_gen.py got no global client")
    assert(onPublished.directory(published).exists("src/dagger_gen.py") == false, "the generated src/dagger_gen.py survived the upgrade")

    let handWritten = ws.withNewFile(published + "/src/dagger_gen.py", "from dagger import *  # mine\n")
    let onHandWritten = pythonSdk
      .generateScope(handWritten.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assertContains(onHandWritten.file(published + "/pyproject.toml").contents, "global-client = true", "a module with a hand-written src/dagger_gen.py was not upgraded")
    assert(onHandWritten.file(published + "/src/dagger_gen.py").contents == "from dagger import *  # mine\n", "generation changed a hand-written src/dagger_gen.py")
    let offPublished = onHandWritten.withChanges(pythonSdk.mod(onHandWritten, path: tomlGenerateModulePath, findUp: false).config.set(globalClient: false))
    let stays = pythonSdk
      .generateScope(offPublished.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assertNotContains(stays.file(published + "/pyproject.toml").contents, "global-client", "src/dagger_gen.py turned the global client on again")
    assert(stays.directory(published).exists("sdk/src/" + globalPackage) == false, "src/dagger_gen.py brought the global client back")

    # A module the builtin runtime ran has no bindings of its own to go by:
    # its manifest says so, whether it is still a pre-1.0 dagger.json or the
    # manifest `dagger module migrate` wrote from one.
    let fromRuntime = pythonSdk
      .generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assertContains(fromRuntime.file(published + "/pyproject.toml").contents, "global-client = true", "a module converted from the builtin runtime did not get the flag")
    assertContains(fromRuntime.file(published + "/sdk/src/" + globalPackage + "/__init__.py").contents, "class Client(", "a module converted from the builtin runtime got no global client")
    let againFromRuntime = pythonSdk
      .generateScope(fromRuntime.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assert(againFromRuntime.changes(fromRuntime).isEmpty, "a second generation changed a module converted from the builtin runtime")

    let fromJson = "/" + generateModulePath
    let migrated = pythonSdk
      .generateScope(ws.withWorkdir(generateModulePath), isModule: true, name: "generate-app", clients: [])
      .withWorkdir(".")
    assertContains(migrated.file(fromJson + "/pyproject.toml").contents, "global-client = true", "a module converted from a pre-1.0 dagger.json did not get the flag")
    assert(migrated.directory(fromJson).exists("sdk/src/" + globalPackage), "a module converted from a pre-1.0 dagger.json got no global client")

    # A scope file that already turns the flag off keeps it off: the code of a
    # module that says so is not the code the global client is for.
    let scopeFilePath = published + "/pyproject.toml"
    let saysNo = ws.withNewFile(scopeFilePath, ws.file(scopeFilePath).contents + "\n[tool.dagger]\nglobal-client = false\n")
    let refused = pythonSdk
      .generateScope(saysNo.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    assertContains(refused.file(scopeFilePath).contents, "global-client = false", "generation rewrote a scope file that turns the global client off")
    assert(refused.directory(published).exists("sdk/src/" + globalPackage) == false, "a scope file that turns the global client off got one anyway")

    null
  }

  """
  Two settings only a runtime reads are refused one at a time, in either
  manifest: the message names the setting and the way out, rather than listing
  it among others. Generation dropped them silently from a dagger.json.
  """
  pub manifestRuntimeSettingsCheck(ws: Workspace!): Void @check {
    let manifestPath = "/" + tomlGenerateModulePath + "/dagger-module.toml"
    let head = "name = \"toml-generate-app\"\n"
    let caching = manifestOf(ws.withNewFile(manifestPath, head + "disableDefaultFunctionCaching = true\n")) rescue {
      err: Error => err.message
    }
    assertContainsAll(caching, ["dagger-module.toml sets disableDefaultFunctionCaching", "pass cache="])
    let codegen = manifestOf(ws.withNewFile(manifestPath, head + "\n[codegen]\nautomaticGitignore = true\n")) rescue {
      err: Error => err.message
    }
    assertContainsAll(codegen, ["dagger-module.toml has a [codegen] table", "remove the table"])

    let jsonPath = "/" + generateModulePath + "/dagger.json"
    let jsonHead = "{\"name\": \"generate-app\", \"engineVersion\": \"v0.20.8\", \"sdk\": {\"source\": \"python\"}"
    let jsonCaching = legacyManifestOf(ws.withNewFile(jsonPath, jsonHead + ", \"disableDefaultFunctionCaching\": true}")) rescue {
      err: Error => err.message
    }
    assertContainsAll(jsonCaching, ["dagger.json sets disableDefaultFunctionCaching", "pass cache="])
    let jsonCodegen = legacyManifestOf(ws.withNewFile(jsonPath, jsonHead + ", \"codegen\": {\"automaticGitignore\": true}}")) rescue {
      err: Error => err.message
    }
    assertContainsAll(jsonCodegen, ["dagger.json has a [codegen] table", "remove the table"])

    null
  }

  """
  A scope whose file names a path dependency outside it locks all the same:
  the package a repository shares between its modules is in the workspace, and
  uv reads it to lock what the scope depends on. Such a module names the
  package under include, which is what puts it in the module source, and keeps
  its runtime for that reason.
  """
  pub generateScopeSharedPathCheck(ws: Workspace!): Void @check {
    let scope = "/" + tomlGenerateModulePath
    let pyprojectPath = scope + "/pyproject.toml"
    let shared = "shared-pkg = { path = \"../../shared-pkg\", editable = true }\n"
    let seeded = ws
      .withNewFile(scope + "/dagger-module.toml",
        "name = \"toml-generate-app\"\nengineVersion = \"v1.0.0-0\"\ninclude = [\"../../shared-pkg\"]\n\n[runtime]\nsource = \"python\"\n")
      .withNewFile(pyprojectPath, ws.file(pyprojectPath).contents
        .replace("dependencies = [\"dagger-io\"]", "dependencies = [\"dagger-io\", \"shared-pkg\"]") + shared)
      # A lock of the layout before, which generation locks again.
      .withNewFile(scope + "/uv.lock", "version = 1\nrequires-python = \">=3.14\"\n")
    let generated = pythonSdk
      .generateScope(seeded.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    let lock = generated.file(scope + "/uv.lock").contents
    assertContainsAll(lock, ["name = \"shared-pkg\"", "name = \"dagger-io\"", "name = \"dagger-clients-core\""])
    assertContains(generated.file(pyprojectPath).contents, shared, "generation dropped the shared path dependency")

    null
  }

  """
  A client whose target is a module in the workspace that was never migrated
  is refused before anything is written: the engine serves a module by its
  manifest, and a target with only a pre-1.0 dagger.json has none. The
  refusal names the target and the command that converts it.
  """
  pub clientTargetManifestCheck(ws: Workspace!): Void @check {
    let legacy = ws.moduleSource("/" + legacyClientDepPath)
    let generated = pythonSdk
      .generateScope(
        ws.withWorkdir(tomlGenerateModulePath),
        isModule: true, name: "toml-generate-app", clients: [legacy],
      )
      .cwd rescue {
        err: Error => err.message
      }
    if (legacy.kind == ModuleSourceKind.GIT_SOURCE) {
      # A workspace loaded from a ref makes every module in it a Git client,
      # which the engine serves from the repository rather than the workspace,
      # and `dagger module migrate` is no answer for one. Generation says
      # nothing then, which is what this asserts, and the refusal is checked
      # wherever the workspace is the one on disk, the floor job among them.
      assertNotContains(generated, "dagger module migrate", "a Git client target was told to migrate in place: " + generated)
    } else {
      assertContainsAll(generated, [
        "the client \"legacy-dep\" loads /" + legacyClientDepPath,
        "has no dagger-module.toml",
        "dagger module migrate /" + legacyClientDepPath,
      ])
    }

    let migrated = pythonSdk
      .generateScope(
        ws.withWorkdir(tomlGenerateModulePath),
        isModule: true, name: "toml-generate-app", clients: [ws.moduleSource("/" + clientDepPath)],
      )
      .withWorkdir(".")
    assert(migrated.directory("/" + tomlGenerateModulePath).exists(clientDepMember), "a client whose target has a manifest was refused")

    null
  }

  """
  The flag alone decides: set on a new module, generation emits the global
  client and the SDK files' dependency on each client; cleared, generation
  removes both.
  """
  pub generateScopeGlobalClientFlagCheck(ws: Workspace!): Void @check {
    let root = "/" + tomlGenerateModulePath
    let client = ws.moduleSource("/" + clientDepPath)
    # A manifest of this SDK's own, so that nothing but the flag asks for the
    # global client: the fixture's names the builtin runtime, which does.
    let plain = ws.withNewFile(root + "/dagger-module.toml", "name = \"toml-generate-app\"\n")
    let fresh = pythonSdk
      .generateScope(plain.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [client])
      .withWorkdir(".")
    assert(fresh.directory(root).exists("sdk/src/" + globalPackage) == false, "a module without the flag got the global client")

    let flagged = fresh.withChanges(pythonSdk.mod(fresh, path: tomlGenerateModulePath, findUp: false).config.set(globalClient: true))
    let on = pythonSdk
      .generateScope(flagged.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [client])
      .withWorkdir(".")
    assertContains(on.file(root + "/sdk/src/" + globalPackage + "/__init__.py").contents, "def client_dep(", "the global client lacks the client")
    assertContains(on.file(root + "/" + sdkMemberFile).contents, "\"dagger-clients-client-dep\",", "the SDK files do not depend on the client the global client imports")

    let cleared = on.withChanges(pythonSdk.mod(on, path: tomlGenerateModulePath, findUp: false).config.set(globalClient: false))
    let off = pythonSdk
      .generateScope(cleared.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [client])
      .withWorkdir(".")
    assert(off.directory(root).exists("sdk/src/" + globalPackage) == false, "clearing the flag kept the global client")
    assertNotContains(off.file(root + "/" + sdkMemberFile).contents, "dagger-clients-client-dep", "clearing the flag kept the SDK files' dependency on the client")
    assert(
      off.directory(root + "/sdk").digest == fresh.directory(root + "/sdk").digest,
      "clearing the flag did not give back the SDK files of a module that never had it",
    )

    null
  }

  """
  A scope without a module gets the same tree as a module, and no module
  config. Its scope file is created when it has none. The client member is
  byte for byte the one a module scope gets, because a member's files do not
  depend on the scope that holds them.
  """
  pub generateScopePlainCheck(ws: Workspace!): Void @check {
    let scope = outputRoot + "/plain-scope"
    let client = ws.moduleSource("/" + clientDepPath)
    let bare = ws.withNewDirectory("/" + scope, directory).withWorkdir(scope)

    let empty = pythonSdk.generateScope(bare, isModule: false, name: "plain-scope", clients: []).withWorkdir(".")
    assertScopeTree(empty, scope)
    assert(empty.directory("/" + scope).exists("dagger-module.toml") == false, "a scope without a module got a module config")

    let plain = pythonSdk.generateScope(bare, isModule: false, name: "plain-scope", clients: [client]).withWorkdir(".")
    assertScopeTree(plain, scope)
    assertContainsAll(plain.file("/" + scope + "/pyproject.toml").contents, ["\"clients/client-dep\"", "dagger-clients-client-dep = { workspace = true }"])
    assertNotContains(plain.file("/" + scope + "/pyproject.toml").contents, "[project]", "the SDK invented a [project] table")

    # The committed fixture has a [project] table, so the client becomes a dependency.
    let fixture = pythonSdk.generateScope(ws.withWorkdir(plainScopePath), isModule: false, name: "plain", clients: [client]).withWorkdir(".")
    assertContains(fixture.file("/" + plainScopePath + "/pyproject.toml").contents, "\"dagger-clients-client-dep\"", "the client did not become a dependency of the scope")

    let module = pythonSdk.generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [client]).withWorkdir(".")
    assert(
      plain.directory("/" + scope + "/" + clientDepMember).digest == module.directory("/" + tomlGenerateModulePath + "/" + clientDepMember).digest,
      "one client differs between a scope without a module and a module",
    )
    assert(
      plain.directory("/" + scope + "/clients/core").digest == module.directory("/" + tomlGenerateModulePath + "/clients/core").digest,
      "core differs between a scope without a module and a module",
    )

    null
  }

  """
  The SDK owns its entries in the scope file and its members under clients/,
  nothing else: user tables, comments and members survive byte for byte, a
  user member under clients/ stays in the workspace, a directory under
  clients/ without the marker is never deleted, and one is never written over.
  """
  pub generateScopeUserContentCheck(ws: Workspace!): Void @check {
    let scope = outputRoot + "/user-content"
    let client = ws.moduleSource("/" + clientDepPath)
    let userFile =
      "# the user's own comment\n" +
      "[project]\nname = \"user-content\"\nversion = \"0.1.0\"\n" +
      "dependencies = [\n    \"dagger-io\",\n    \"httpx>=0.27\",  # a pin of the user's\n]\n\n" +
      "[tool.uv.workspace]\nmembers = [\"tools/mine\", \"clients/tools\"]\n\n" +
      "[tool.uv.sources]\nmine = { workspace = true }\n\n" +
      "[tool.mine]\nanswer = 42\n"
    let seeded = ws
      .withNewFile("/" + scope + "/pyproject.toml", userFile)
      .withNewFile("/" + scope + "/tools/mine/pyproject.toml", "[project]\nname = \"mine\"\n")
      .withNewFile("/" + scope + "/clients/tools/pyproject.toml", "[project]\nname = \"tools\"\n")
      .withNewFile("/" + scope + "/clients/notes/README.md", "not a member\n")
      .withNewFile("/" + scope + "/clients/handmade/pyproject.toml", "[project]\nname = \"handmade\"\ndescription = \"\"\"\n[tool.dagger]\ngenerated = \"client\"\n\"\"\"\n")
      .withNewFile("/" + scope + "/clients/handmade/secret.txt", "mine\n")
      # A marker that cannot be read never licenses a delete.
      .withNewFile("/" + scope + "/clients/brokentoml/pyproject.toml", "this is not = valid toml [[[\n")
      .withNewFile("/" + scope + "/clients/brokentoml/secret.txt", "mine\n")
      .withNewFile("/" + scope + "/clients/numbermark/pyproject.toml", "[tool.dagger]\ngenerated = 42\n")
      .withNewFile("/" + scope + "/clients/numbermark/secret.txt", "mine\n")
      .withNewFile("/" + scope + "/clients/emptyfile/pyproject.toml", "")
      .withNewFile("/" + scope + "/clients/emptyfile/secret.txt", "mine\n")
      .withNewFile("/" + scope + "/clients/nofile/secret.txt", "mine\n")
      .withWorkdir(scope)
    let generated = pythonSdk.generateScope(seeded, isModule: false, name: "user-content", clients: [client]).withWorkdir(".")
    let after = generated.file("/" + scope + "/pyproject.toml").contents
    assertContainsAll(after, [
      "# the user's own comment\n[project]\nname = \"user-content\"\n",
      "    \"httpx>=0.27\",  # a pin of the user's\n",
      "\"tools/mine\"",
      "\"clients/tools\"",
      "mine = { workspace = true }\n",
      "[tool.mine]\nanswer = 42\n",
    ])
    assert(generated.directory("/" + scope).exists("clients/notes/README.md"), "a directory under clients/ without the marker was deleted")

    let removed = pythonSdk.generateScope(generated.withWorkdir(scope), isModule: false, name: "user-content", clients: []).withWorkdir(".")
    assert(removed.directory("/" + scope).exists("clients/notes/README.md"), "removing a client deleted a directory without the marker")
    assert(removed.directory("/" + scope).exists("clients/handmade/secret.txt"), "text that only looks like the marker, in a string, got a directory deleted")
    ["brokentoml", "numbermark", "emptyfile", "nofile"].each { dir =>
      assert(generated.directory("/" + scope).exists("clients/" + dir + "/secret.txt"), "generation deleted clients/" + dir + ", whose marker cannot be read")
      assert(removed.directory("/" + scope).exists("clients/" + dir + "/secret.txt"), "removing a client deleted clients/" + dir + ", whose marker cannot be read")
      null
    }
    assert(removed.directory("/" + scope).exists(clientDepMember) == false, "a removed client's member was left behind")
    let removedFile = removed.file("/" + scope + "/pyproject.toml").contents
    assertNotContains(removedFile, "\"" + clientDepMember + "\"", "a removed client stayed a workspace member")
    assertContains(removedFile, "\"clients/tools\"", "removing a client dropped the user's member under clients/")
    assert(removed.directory("/" + scope).exists("clients/tools/pyproject.toml"), "removing a client deleted the user's member under clients/")

    let squatted = ws.withNewFile("/" + scope + "/" + clientDepMember + "/mine.txt", "mine\n").withWorkdir(scope)
    let over = pythonSdk.generateScope(squatted, isModule: false, name: "user-content", clients: [client]).cwd rescue "raised"
    assert(over == "raised", "a client was written over a directory without the marker")

    let unknown = ws
      .withNewFile("/" + scope + "/clients/core/pyproject.toml", "[project]\nname = \"core\"\n\n[tool.dagger]\ngenerated = \"hand-written\"\n")
      .withNewFile("/" + scope + "/clients/core/mine.txt", "mine\n")
      .withWorkdir(scope)
    let overUnknown = pythonSdk.generateScope(unknown, isModule: false, name: "user-content", clients: []).cwd rescue "raised"
    assert(overUnknown == "raised", "core was written over a member marked with a kind the SDK does not write")

    # Nor an overwrite, even at a path generation certainly owns.
    let corrupted = ws
      .withNewFile("/" + scope + "/clients/core/pyproject.toml", "this is not = valid toml [[[\n")
      .withNewFile("/" + scope + "/clients/core/mine.txt", "mine\n")
      .withWorkdir(scope)
    let overCorrupted = pythonSdk.generateScope(corrupted, isModule: false, name: "user-content", clients: []).cwd rescue {
      err: Error => err.message
    }
    assertContainsAll(overCorrupted, ["clients/core/ exists in", "is not a generated core; move it away"])

    # sdk/ from an earlier SDK carries no marker either, so only the header of
    # its generated bindings tells it from one the user wrote.
    let vendored = ws
      .withNewFile("/" + scope + "/sdk/src/dagger/__init__.py", "# my own dagger\n")
      .withNewFile("/" + scope + "/sdk/src/dagger/client/gen.py", "# written by hand\n")
      .withWorkdir(scope)
    let overSdk = pythonSdk.generateScope(vendored, isModule: false, name: "user-content", clients: []).cwd rescue {
      err: Error => err.message
    }
    assertContainsAll(overSdk, ["sdk/ exists", "was not written by dagger generate", "move or rename it"])

    null
  }

  """
  `mod generate` writes the same tree as the scope generation, with the
  clients the workspace declares for the module's scope.
  """
  pub modGenerateClientsCheck(scope: Workspace!): Void @check {
    let ws = withScope(scope, tomlGenerateModulePath, "toml-generate-app")
    # A client added from the scope names its module from there.
    let scoped = ws.withWorkdir(tomlGenerateModulePath)
      .withClient(module: "../../clients/dep", sdk: "python")
      .withWorkdir(".")
    let generated = pythonSdk.mod(scoped, path: tomlGenerateModulePath).generated
    assertScopeTree(generated, tomlGenerateModulePath)
    let declared = ws.moduleSource("/" + clientDepPath)
    assertContains(generated.file("/" + tomlGenerateModulePath + "/" + clientDepTargetPath).contents, "REF = \"" + clientRef(declared, clientDepPath) + "\"", "mod generate missed the scope's client")
    let viaScope = pythonSdk
      .generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [ws.moduleSource("/" + clientDepPath)])
      .withWorkdir(".")
    assert(
      generated.directory("/" + tomlGenerateModulePath).withoutFile("dagger-module.toml").digest ==
        viaScope.directory("/" + tomlGenerateModulePath).withoutFile("dagger-module.toml").digest,
      "mod generate and the scope generation wrote different trees",
    )
    null
  }

  """
  Generation reports only what it produced: dagger.json and the committed
  .gitattributes are already on disk, so a changeset adding either describes
  the workspace base, not the generated context.
  """
  pub generateSkipsExistingFilesCheck(scope: Workspace!): Void @check {
    let ws = withScope(scope, generateModulePath, "generate-app")
    let existing = [
      generateModulePath + "/dagger.json",
      generateModulePath + "/.gitattributes",
    ]

    assertNoneAdded(pythonSdk.mod(ws, path: generateModulePath).generate, existing, "generate")

    null
  }

  """
  Generating a pre-1.0 module is still left to the engine's builtin Python
  SDK, which vendors its bindings; the module is not upgraded behind the
  user's back.
  """
  pub generateCheck(scope: Workspace!): Void @check {
    let ws = withScope(scope, generateModulePath, "generate-app")
    let changes = pythonSdk.mod(ws, path: generateModulePath).generate

    assertAdded(changes, generateModulePath + "/" + legacyBindingsPath)
    assertContains(changes.layer.file(generateModulePath + "/" + legacyBindingsPath).contents, generatedMarkerContents, "generate did not include the SDK code-generated marker")

    null
  }

  """
  A dagger-module.toml module is generated by this SDK's generator, not the
  engine's builtin: the tell is that the builtin vendors its whole sdk/python
  tree, runtime included.
  """
  pub tomlGenerateCheck(scope: Workspace!): Void @check {
    let ws = withScope(scope, tomlGenerateModulePath, "toml-generate-app")
    let changes = pythonSdk.mod(ws, path: tomlGenerateModulePath).generate

    assertAdded(changes, tomlGenerateModulePath + "/" + sdkMemberFile)
    assertAdded(changes, tomlGenerateModulePath + "/" + coreInitPath)
    assert(
      contains(changes.addedPaths, tomlGenerateModulePath + "/sdk/runtime/dagger.json") == false,
      "the module was generated by the engine's builtin Python SDK, not this one",
    )

    # Vendored at some point and must not come back: a scope needs only the
    # importable library, and its bindings are members of their own.
    assertNoneAdded(
      changes,
      [
        tomlGenerateModulePath + "/sdk/codegen/pyproject.toml",
        tomlGenerateModulePath + "/sdk/uv.lock",
        tomlGenerateModulePath + "/" + legacyBindingsPath,
      ],
      "generate",
    )

    null
  }

  """
  uv locks a scope to the SDK's Python floor whatever the module asks for, so
  a module the runtime would build on an older Python fails at install, long
  after generation. Generation refuses it first, unless the module names a
  base image of its own, which the runtime builds on as named.
  """
  pub pythonFloorRefusalCheck(scope: Workspace!): Void @check {
    let ws = withScope(scope, tomlGenerateModulePath, "toml-generate-app")
    let pyprojectPath = tomlGenerateModulePath + "/pyproject.toml"
    let pyproject = ws.file("/" + pyprojectPath).contents
    let onFloor = pyproject.replace("requires-python = \">=3.14\"", "requires-python = \">=3.12\"")
    let belowFloor = pyproject.replace("requires-python = \">=3.14\"", "requires-python = \">=3.11\"")
    assert(belowFloor != pyproject, "the fixture asks for no Python to lower")

    let floor = pythonSdk.mod(ws.withNewFile("/" + pyprojectPath, onFloor), path: tomlGenerateModulePath).generate
    assertAdded(floor, tomlGenerateModulePath + "/" + sdkMemberFile)

    let older = pythonSdk.mod(ws.withNewFile("/" + pyprojectPath, belowFloor), path: tomlGenerateModulePath).generated.cwd rescue {
      err: Error => err.message
    }
    assertContainsAll(older, [
      "the module at " + tomlGenerateModulePath + ": this Python SDK needs Python 3.12 or later",
      "requires-python = \">=3.11\" asks for Python 3.11. Ask for Python 3.12 or later",
      "pin the last release of this SDK that runs on it: dagger module install github.com/dagger/python-sdk@v1.2.0",
      "then run dagger generate again",
    ])

    let ownImage = belowFloor + "\n[tool.dagger]\nbase-image = \"python:3.14-slim\"\n"
    let onOwnImage = pythonSdk.mod(ws.withNewFile("/" + pyprojectPath, ownImage), path: tomlGenerateModulePath).generate
    assertAdded(onOwnImage, tomlGenerateModulePath + "/" + sdkMemberFile)

    let pinned = ws.withNewFile("/" + tomlGenerateModulePath + "/.python-version", "3.11\n")
    let pinRefused = pythonSdk.mod(pinned, path: tomlGenerateModulePath).generated.cwd rescue {
      err: Error => err.message
    }
    assertContains(pinRefused, "this Python SDK needs Python 3.12 or later, and .python-version pins Python 3.11. Set it to Python 3.12 or later", "a module pinned to Python 3.11 was generated")

    let initScope = outputRoot + "/python-floor-init"
    let initRefused = pythonSdk(template: "empty", pythonVersion: "3.11")
      .generateScope(scope.withNewDirectory("/" + initScope, directory).withWorkdir(initScope), isModule: true, name: "python-floor-init", clients: [])
      .cwd rescue {
        err: Error => err.message
      }
    assertContains(initRefused, "asks for Python 3.11", "a new module asking for Python 3.11 was initialized")

    let setRefused = pythonSdk.mod(ws, path: tomlGenerateModulePath).config.set(pythonVersion: "3.11").after.file(pyprojectPath).contents rescue {
      err: Error => err.message
    }
    assertContains(setRefused, "asks for Python 3.11", "config set wrote Python 3.11")

    null
  }

  """
  A module on this repository's runtime builds and runs, driven through the
  floor release's CLI. The fixture points `[runtime] source` at `runtime/` by relative
  path, so the runtime in this working tree answers.
  """
  pub runtimeCallCheck(ws: Workspace!): Void @check {
    let called = cli(playground(ws), ["-m", runtimeModulePath, "call", "greeting"]).stdout
    assertContains(called, runtimeGreeting, "the module did not run on this repository's runtime")

    null
  }

  """
  The runtime refuses a module whose generated files are missing instead of
  regenerating them: the no-codegen-at-load contract, which the engine's
  builtin honours too.
  """
  pub runtimeRequiresGeneratedFilesCheck(ws: Workspace!): Void @check {
    let stripped = playgroundTree(ws).withoutFile(runtimeModulePath + "/sdk/pyproject.toml")
    let refused = playgroundOf(stripped)
      .withExec(["dagger", "-m", runtimeModulePath, "call", "greeting"], experimentalPrivilegedNesting: true, expect: ReturnType.FAILURE)
      .stderr
    assertContains(refused, "run `dagger generate` and commit", "the runtime did not report the missing generated file")

    null
  }

  """
  A module scope builds from its workspace: the SDK files, core and the
  client are installed from their members, not editable, whether the module
  builds with uv, with pip, or from the uv.lock that generation locked again.
  """
  pub runtimeScopeInstallCheck(ws: Workspace!): Void @check {
    let pyprojectPath = "/" + tomlGenerateModulePath + "/pyproject.toml"
    let lockPath = "/" + tomlGenerateModulePath + "/uv.lock"
    let pip = ws.withNewFile(pyprojectPath, ws.file(pyprojectPath).contents + "\n[tool.dagger]\nuse-uv = false\n")
    # A lock of the layout before, which names none of the members.
    let stale = ws.withNewFile(lockPath, "version = 1\nrequires-python = \">=3.14\"\n")

    let built = assertInstalled(ws, "uv")
    assertInstalled(pip, "pip")
    let locked = assertInstalled(stale, "uv.lock")
    assertContains(locked.file(lockPath).contents, "name = \"dagger-clients-client-dep\"", "generation did not lock the client")

    # A member the scope lists and the tree lacks is refused before the build.
    let withoutCore = built.withoutFile("/" + tomlGenerateModulePath + "/" + coreMemberFile)
    let refused = pythonSdkRuntime
      .moduleRuntime(modSource: runtimeSource(withoutCore, tomlGenerateModulePath), introspectionJson: null)
      .withExec(["true"])
      .stdout rescue "raised"
    assert(refused == "raised", "a scope without its core member was built")

    # Only the members the project depends on are installed, as `uv sync`
    # installs them: a user member nothing depends on may not even install
    # here, and pip or an unlocked uv must not try.
    # The dependencies are the ones a real project writes: extras, an escaped
    # quote in a marker, a literal string with a backslash, and a multi-line
    # string in [project] holding text that looks like keys (a readme, since
    # uv_build wants a one-line description). The markers are false, so
    # nothing is fetched.
    let members = ws
      .withNewFile(pyprojectPath, ws.file(pyprojectPath).contents
        .replace("dependencies = [\"dagger-io\"]",
          "dependencies = [\n" +
          "  \"dagger-io\",\n" +
          "  \"used[extra]>=0.1\",\n" +
          "  \"tomli; python_version < \\\"3.0\\\"\",  # an escaped quote\n" +
          "  'tomli; python_version < \"3.0\" and os_name == \"C:\\dir\"',  # a literal string\n" +
          "]\n" +
          "readme = { text = \"\"\"\ndependencies = 42\nmembers = [[\"nope\"]]\n\"\"\", content-type = \"text/plain\" }")
        .replace("[tool.uv.sources]\n", "[tool.uv.sources]\nused = { workspace = true }\n") +
        "\n[tool.uv.workspace]\nmembers = [\"tools/used\", \"tools/unused\"]\n")
      .withNewFile("/" + tomlGenerateModulePath + "/tools/used/pyproject.toml", userMember("used", ">=3.10"))
      .withNewFile("/" + tomlGenerateModulePath + "/tools/used/src/used/__init__.py", "")
      .withNewFile("/" + tomlGenerateModulePath + "/tools/unused/pyproject.toml", userMember("unused", ">=99"))
      .withNewFile("/" + tomlGenerateModulePath + "/tools/unused/src/unused/__init__.py", "")
    assertMembersInstalled(members, "uv")
    assertMembersInstalled(members.withNewFile(pyprojectPath, members.file(pyprojectPath).contents + "\n[tool.dagger]\nuse-uv = false\n"), "pip")

    # A path source's own path sources are installed too: uv reads them when
    # it builds the path source, with a lock or without one.
    let modPath = "/" + tomlGenerateModulePath
    let nested = ws
      .withNewFile(pyprojectPath, ws.file(pyprojectPath).contents
        .replace("dependencies = [\"dagger-io\"]", "dependencies = [\"dagger-io\", \"nested-a\"]")
        .replace("[tool.uv.sources]\n", "[tool.uv.sources]\nnested-a = { path = \"vendor/a\" }\n"))
      .withNewFile(modPath + "/vendor/a/pyproject.toml",
        userMember("nested-a", ">=3.10").replace("[project.optional", "dependencies = [\"nested-b\"]\n[project.optional") +
        "\n[tool.uv.sources]\nnested-b = { path = \"../b\" }\n")
      .withNewFile(modPath + "/vendor/a/src/nested_a/__init__.py", "")
      .withNewFile(modPath + "/vendor/b/pyproject.toml", userMember("nested-b", ">=3.10"))
      .withNewFile(modPath + "/vendor/b/src/nested_b/__init__.py", "")
    assertNestedInstalled(nested, "uv")
    assertNestedInstalled(nested.withNewFile(lockPath, "version = 1\nrequires-python = \">=3.14\"\n"), "uv.lock")

    # A member whose pyproject.toml does not read is named, not shown as a
    # traceback from the reader.
    let broken = pythonSdk
      .generateScope(members.withNewFile("/" + tomlGenerateModulePath + "/tools/unused/pyproject.toml", "[project\n").withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    let brokenBuild = pythonSdkRuntime
      .moduleRuntime(modSource: runtimeSource(broken, tomlGenerateModulePath), introspectionJson: null)
      .withExec(["true"])
      .stdout rescue {
        err: Error => err.message
      }
    assertContains(brokenBuild, "tools/unused/pyproject.toml is not valid TOML", "a broken member was not named: " + brokenBuild)
    assertNotContains(brokenBuild, "Traceback", "a broken member surfaced as a traceback")

    null
  }

  let userMember(name: String!, requiresPython: String!): String! {
    "[project]\nname = \"" + name + "\"\nversion = \"0.1.0\"\nrequires-python = \"" + requiresPython + "\"\n" +
      "[project.optional-dependencies]\nextra = []\n\n" +
      "[build-system]\nrequires = [\"uv_build>=0.8.4,<0.12.0\"]\nbuild-backend = \"uv_build\"\n"
  }

  let assertMembersInstalled(seeded: Workspace!, what: String!): Void {
    let generated = assertInstalled(seeded, what)
    let out = pythonSdkRuntime
      .moduleRuntime(modSource: runtimeSource(generated, tomlGenerateModulePath), introspectionJson: null)
      .withExec(["python", "-c",
        "import importlib.util as u, sys\n" +
        "sys.exit('used is missing' if u.find_spec('used') is None else 'unused was installed' if u.find_spec('unused') else print('members') or 0)\n",
      ])
      .stdout
    assertContains(out, "members", what + ": " + out)
    null
  }

  let assertNestedInstalled(seeded: Workspace!, what: String!): Void {
    let out = pythonSdkRuntime
      .moduleRuntime(modSource: runtimeSource(assertInstalled(seeded, what), tomlGenerateModulePath), introspectionJson: null)
      .withExec(["python", "-c", "import nested_a, nested_b; print('nested')"])
      .stdout
    assertContains(out, "nested", what + ": " + out)
    null
  }

  """
  A path source outside the module directory, which the module loads with
  include, is one input of the dependency install rather than a reason to
  read the whole context: an edit of the module's own code keeps the install,
  and an edit of the path source installs it again.
  """
  pub runtimePathSourceInstallCheck(ws: Workspace!): Void @check {
    let generated = pathSourceGenerated(ws, "[\"../../shared-pkg\"]")
    let installed = sharedInstalledAt(generated)
    let sourcePath = "/" + tomlGenerateModulePath + "/src/toml_generate_app/__init__.py"
    let edited = generated.withNewFile(sourcePath, generated.file(sourcePath).contents + "\n# edited\n")
    assert(sharedInstalledAt(edited) == installed, "an edit of the module's own code installed its path source again")
    let sharedPath = "/" + fixtureRoot + "/shared-pkg/src/shared_pkg/__init__.py"
    let shared = edited.withNewFile(sharedPath, generated.file(sharedPath).contents + "\n# edited\n")
    assert(sharedInstalledAt(shared) != installed, "an edit of the path source kept the install before it")
    null
  }

  """
  A path source whose own uv settings name a directory beside it reads the
  whole context, so an edit of that directory installs the path source again.
  """
  pub runtimePathSourceSettingsCheck(ws: Workspace!): Void @check {
    let sharedPyproject = "/" + fixtureRoot + "/shared-pkg/pyproject.toml"
    let wheelhouse = "/" + fixtureRoot + "/wheelhouse/README"
    let generated = pathSourceGenerated(ws
      .withNewFile(sharedPyproject, ws.file(sharedPyproject).contents + "\n[tool.uv]\nfind-links = [\"../wheelhouse\"]\n")
      .withNewFile(wheelhouse, "wheels\n"), "[\"../../shared-pkg\", \"../../wheelhouse\"]")
    let installed = sharedInstalledAt(generated)
    let edited = generated.withNewFile(wheelhouse, "wheels, edited\n")
    assert(sharedInstalledAt(edited) != installed, "an edit of the directory its path source's settings name kept the install before it")
    null
  }

  """
  The fixture module, generated with a dependency on the shared package as a
  path source that the manifest's include array loads.
  """
  let pathSourceGenerated(ws: Workspace!, include: String!): Workspace! {
    let scope = "/" + tomlGenerateModulePath
    let pyprojectPath = scope + "/pyproject.toml"
    let seeded = ws
      .withNewFile(scope + "/dagger-module.toml",
        "name = \"toml-generate-app\"\nengineVersion = \"v1.0.0-0\"\ninclude = " + include + "\n\n[runtime]\nsource = \"python\"\n")
      .withNewFile(pyprojectPath, ws.file(pyprojectPath).contents
        .replace("dependencies = [\"dagger-io\"]", "dependencies = [\"dagger-io\", \"shared-pkg\"]") +
        "shared-pkg = { path = \"../../shared-pkg\", editable = true }\n")
      .withNewFile(scope + "/uv.lock", "version = 1\nrequires-python = \">=3.14\"\n")
    pythonSdk
      .generateScope(seeded.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
  }

  """
  When the build installed the shared package: a dependency install that is
  cached gives back the same files, and one that runs again writes new ones.
  """
  let sharedInstalledAt(generated: Workspace!): String! {
    pythonSdkRuntime
      .moduleRuntime(modSource: runtimeSource(generated, tomlGenerateModulePath), introspectionJson: null)
      .withExec(["python", "-c", "import os, shared_pkg; print(os.stat(shared_pkg.__file__).st_mtime_ns)"])
      .stdout
      .trimSpace
  }

  """The generated module, after its build found each member installed."""
  let assertInstalled(seeded: Workspace!, what: String!): Workspace! {
    let generated = pythonSdk
      .generateScope(seeded.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [seeded.moduleSource("/" + clientDepPath)])
      .withWorkdir(".")
    let out = pythonSdkRuntime
      .moduleRuntime(modSource: runtimeSource(generated, tomlGenerateModulePath), introspectionJson: null)
      .withExec(["python", "-c", installedProbe])
      .stdout
    assertContains(out, "installed", what + ": " + out)
    generated
  }

  """
  A generated module as the runtime module takes it, which is how both
  entrypoints build it too: with its entrypoint table swapped for the builtin
  runtime, since a module source handed to a runtime names one.
  """
  let runtimeSource(generated: Workspace!, path: String!): ModuleSource! {
    let manifestPath = "/" + path + "/dagger-module.toml"
    generated
      .withNewFile(manifestPath, generated.file(manifestPath).contents.replaceMatches("(?ms)^\\[entrypoint\\].*?(^\\[|\\z)", "[runtime]\n  source = \"python\"\n\n$1"))
      .moduleSource("/" + path)
  }

  """
  Finds each package without importing it, so the check holds whatever the
  SDK files import. The module's source is mounted under /src, so an origin
  there is an editable install.
  """
  let installedProbe: String! =
    "import importlib.util as u, sys\n" +
    "for name in ('dagger', 'dagger_clients.core', 'dagger_clients.client_dep'):\n" +
    "    spec = u.find_spec(name)\n" +
    "    if spec is None or spec.origin.startswith('/src/'):\n" +
    "        sys.exit(name + ' is not installed from its member: ' + str(spec and spec.origin))\n" +
    "print('installed')\n"

  """
  A module calls the client it declared: its code imports the client and
  calls the client's module through the engine, on this repository's
  runtime, driven through the floor release's CLI.
  """
  pub runtimeClientCallCheck(ws: Workspace!): Void @check {
    let sourcePath = "/" + tomlGenerateModulePath + "/src/toml_generate_app/__init__.py"
    let calling = ws.withNewFile(sourcePath,
      "from dagger import function, object_type\n" +
      "from dagger_clients.client_dep import client_dep\n\n\n" +
      "@object_type\n" +
      "class TomlGenerateApp:\n" +
      "    @function\n" +
      "    async def greeting(self) -> str:\n" +
      "        return await client_dep().greeting()\n")
    let generated = pythonSdk
      .generateScope(calling.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [calling.moduleSource("/" + clientDepPath)])
      .withWorkdir(".")
      # The runtime of this working tree, as the runtime fixture names it.
      .withNewFile("/" + tomlGenerateModulePath + "/dagger-module.toml", runtimeOnlyManifest("toml-generate-app"))
    let called = cli(playground(generated), ["-m", tomlGenerateModulePath, "call", "greeting"]).stdout
    assertContains(called, "hello from the client dependency", "the module did not call its client: " + called)

    null
  }

  """
  An upgraded module's code runs unchanged through the global client: `dag`
  and `dagger.Directory` are core's, on this repository's runtime, driven
  through the floor release's CLI. No client is called, so no module is loaded.
  """
  pub runtimeGlobalClientCallCheck(ws: Workspace!): Void @check {
    let sourcePath = "/" + runtimeModulePath + "/src/runtime_app/__init__.py"
    let legacy = ws.withNewFile(sourcePath,
      "import dagger\n" +
      "from dagger import dag, function, object_type\n\n\n" +
      "@object_type\n" +
      "class RuntimeApp:\n" +
      "    @function\n" +
      "    async def greeting(self) -> str:\n" +
      "        d = dag.directory().with_new_file(\"a\", \"served through the global client\")\n" +
      "        assert isinstance(d, dagger.Directory), type(d)\n" +
      "        return await d.file(\"a\").contents() + \" by \" + type(d).__module__\n")
    let upgraded = pythonSdk
      .generateScope(legacy.withWorkdir(runtimeModulePath), isModule: true, name: "runtime-app", clients: [])
      .withWorkdir(".")
      .withNewFile("/" + runtimeModulePath + "/dagger-module.toml", runtimeOnlyManifest("runtime-app"))
    let called = cli(playground(upgraded), ["-m", runtimeModulePath, "call", "greeting"]).stdout
    assertContains(called, "served through the global client by dagger_clients.core", "the upgraded module did not run through the global client: " + called)

    null
  }

  """
  A manifest on this working tree's runtime and nothing else, so a released
  CLI runs the module on this repository's build, not a published entrypoint.
  """
  """
  The reference a client's descriptor must name, which is what the workspace
  resolved the client to: a path from the workspace root for a client the
  engine serves out of the workspace, and a Git address for one in a workspace
  that is itself loaded from a ref, as it is when these checks run on a commit.
  """
  let clientRef(client: ModuleSource!, path: String!): String! {
    if (client.kind == ModuleSourceKind.GIT_SOURCE) { client.asString } else { "/" + path }
  }

  """The pin that goes with it: a commit for a Git client, nothing for a local one."""
  let clientPin(client: ModuleSource!): String! {
    if (client.kind == ModuleSourceKind.GIT_SOURCE) { "\"" + (client.pin ?? "") + "\"" } else { "None" }
  }

  let runtimeOnlyManifest(name: String!): String! {
    "name = \"" + name + "\"\nengineVersion = \"v1.0.0-0\"\n\n[runtime]\nsource = \"../../../../../../runtime\"\n"
  }

  let sharedEntrypointSource: String! = "dagger.io/sdk/python/entrypoint@v1"

  let sdkRuntimeSource: String! = "dagger.io/sdk/python/runtime@v1"

  """The manifest generating the toml-generate fixture leaves, from a seeded workspace."""
  let manifestOf(seeded: Workspace!): String! {
    manifestWithClients(seeded, [])
  }

  let legacyManifestOf(seeded: Workspace!): String! {
    pythonSdk
      .generateScope(seeded.withWorkdir(generateModulePath), isModule: true, name: "generate-app", clients: [])
      .withWorkdir(".")
      .file("/" + generateModulePath + "/dagger-module.toml").contents
  }

  let manifestWithClients(seeded: Workspace!, clients: [ModuleSource!]!): String! {
    pythonSdk
      .generateScope(seeded.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: clients)
      .withWorkdir(".")
      .file("/" + tomlGenerateModulePath + "/dagger-module.toml").contents
  }

  """
  A module runs on a Dang entrypoint and on nothing else: generation names
  the shared entrypoint and no runtime. The builtin runtime this SDK wrote
  before goes, with the engine version only a runtime reads.

  A stale module-kind entrypoint is replaced, because the engine rejects the
  kind. A Dang entrypoint the user wrote is kept: a pinned version, or a fork.
  A runtime of the user's own is kept as it is, with no entrypoint put in
  front of it for the engine to follow instead, and refused beside one. A
  manifest that says what only a runtime can honour, which files the module
  is and where its source sits, keeps its runtime for the same reason, rather
  than losing the setting or being refused. The manifests carry their keys in
  either order and a "[" inside a comment, which must not be read as the
  start of the next table.
  """
  pub entrypointManifestCheck(ws: Workspace!): Void @check {
    let manifestPath = "/" + tomlGenerateModulePath + "/dagger-module.toml"
    let name = "toml-generate-app"
    let head = "name = \"" + name + "\"\nengineVersion = \"v1.0.0-0\"\n"
    let runtimeTable = "[runtime]\nsource = \"python\"\n"
    let noRuntime = ["[runtime]", "engineVersion"]

    let plain = manifestOf(ws)
    assertContainsAll(plain, ["[entrypoint]", "kind = \"dang\"", "source = \"./sdk/entrypoint\""])
    assertContainsNone(plain, noRuntime)

    let stale = manifestOf(ws.withNewFile(manifestPath, head + "\n" +
      "[entrypoint]\nkind = \"module\"\nsource = \"github.com/dagger/python-sdk/runtime\" # [was this]\n\n" +
      runtimeTable))
    assertContainsAll(stale, ["kind = \"dang\"", "source = \"./sdk/entrypoint\""])
    assertContainsNone(stale, noRuntime + ["kind = \"module\"", "python-sdk/runtime"])

    let fork = "github.com/someone/python-sdk/entrypoint@entrypoint/v1"
    let pinned = manifestOf(ws.withNewFile(manifestPath, head + "\n" + runtimeTable + "\n" +
      "[entrypoint]\n# source first, and a bracket [here] in a comment\n" +
      "source = \"" + fork + "\"\nkind = \"dang\"\n"))
    assertContainsAll(pinned, ["kind = \"dang\"", "source = \"" + fork + "\""])
    assertContainsNone(pinned, noRuntime)
    assertNotContains(pinned, sharedEntrypointSource + "\"", "a Dang entrypoint the user wrote was overwritten")

    let ownRuntime = head + "\n[runtime]\nsource = \"../../../../../../runtime\"\n"
    let own = manifestOf(ws.withNewFile(manifestPath, ownRuntime))
    assertContainsAll(own, ["[runtime]", "source = \"../../../../../../runtime\"", "engineVersion = \"v1.0.0-0\""])
    assertNotContains(own, "[entrypoint]", "an entrypoint was put in front of the user's own runtime")
    assert(pythonSdk.mod(ws.withNewFile(manifestPath, ownRuntime), path: tomlGenerateModulePath, findUp: false).entrypointMode == "runtime", "a module on a runtime of its own was not read as one")

    # A runtime of the user's own beside an entrypoint is refused, whichever
    # entrypoint: the engine would run the entrypoint on the session's
    # version, and generation would take core from the runtime's.
    let bothShared = manifestOf(ws.withNewFile(manifestPath, ownRuntime + "\n[entrypoint]\nkind = \"dang\"\nsource = \"" + sharedEntrypointSource + "\"\n")) rescue {
      err: Error => err.message
    }
    assertContainsAll(bothShared, ["both a runtime", "../../../../../../runtime", sharedEntrypointSource, "Remove [entrypoint]"])
    let bothStatic = manifestOf(ws.withNewFile(manifestPath, ownRuntime + "\n[entrypoint]\nkind = \"dang\"\nsource = \"./sdk/entrypoint\"\n")) rescue {
      err: Error => err.message
    }
    assertContainsAll(bothStatic, ["both a runtime", "./sdk/entrypoint"])

    # The builtin runtime cannot build this layout, so a module that stays on a
    # runtime moves to the one this SDK publishes, on the version it generates
    # against rather than the one the pre-1.0 config declared.
    let included = manifestOf(ws.withNewFile(manifestPath, head + "include = [\"src\"]\n\n" + runtimeTable))
    assertContainsAll(included, ["include = [\"src\"]", "[runtime]", "source = \"" + sdkRuntimeSource + "\""])
    assertNotContains(included, "[entrypoint]", "a module of some files only was put on an entrypoint")
    assertContains(included, "engineVersion", "the runtime manifest lost the version it runs on")
    let elsewhere = manifestOf(ws.withNewFile(manifestPath, head + "source = \"sub\"\n\n" + runtimeTable))
    assertContainsAll(elsewhere, ["source = \"sub\"", "source = \"" + sdkRuntimeSource + "\""])
    assertNotContains(elsewhere, "[entrypoint]", "a module rooted elsewhere was put on an entrypoint")
    let here = manifestOf(ws.withNewFile(manifestPath, head + "source = \".\"\n\n" + runtimeTable))
    assertContains(here, "[entrypoint]", "source = \".\" was refused")
    let jsonExcluded = legacyManifestOf(ws.withNewFile("/" + generateModulePath + "/dagger.json",
      "{\"name\": \"generate-app\", \"engineVersion\": \"v0.20.8\", \"sdk\": {\"source\": \"python\"}, \"exclude\": [\"tmp\"]}"))
    # Manifest version 2 has no exclude: the conversion negates it in include.
    assertContainsAll(jsonExcluded, ["include = [\"!tmp\"]", "source = \"" + sdkRuntimeSource + "\""])
    assertNotContains(jsonExcluded, "[entrypoint]", "a pre-1.0 module of some files only was put on an entrypoint")

    # This SDK's static entrypoint is told from any other by its source, the
    # path generation writes, not by its kind, its quoting or its key order.
    let static = ws.withNewFile(manifestPath,
      "name = \"" + name + "\"\n\n[ entrypoint ]\nsource = './sdk/entrypoint'\nkind = \"dang\"\n")
    assert(pythonSdk.mod(static, path: tomlGenerateModulePath, findUp: false).entrypointMode == "generated", "a static entrypoint written source-first was not recognised")
    let shared = ws.withNewFile(manifestPath, head + "\n[entrypoint]\nkind = \"dang\"\nsource = \"" + sharedEntrypointSource + "\"\n")
    assert(pythonSdk.mod(shared, path: tomlGenerateModulePath, findUp: false).entrypointMode == "remote", "the shared entrypoint was taken for a static one")

    # An entrypoint this SDK did not write is the user's, and is kept as
    # written: a path of their own in the module, and a fork quoted their way.
    let ownPath = head + "\n[entrypoint]\nkind = \"dang\"\nsource = \"./my-entrypoint\"\n"
    let ownManifest = manifestOf(ws.withNewFile(manifestPath, ownPath))
    assertContains(ownManifest, "source = \"./my-entrypoint\"", "a Dang entrypoint of the user's own was replaced: " + ownManifest)
    assertNotContains(ownManifest, sharedEntrypointSource, "a Dang entrypoint of the user's own was replaced: " + ownManifest)
    assert(pythonSdk.mod(ws.withNewFile(manifestPath, ownPath), path: tomlGenerateModulePath, findUp: false).entrypointMode == "remote", "an entrypoint of the user's own was taken for the static one")
    let quoted = manifestOf(ws.withNewFile(manifestPath, head + runtimeTable + "\n[entrypoint]\nkind = 'dang'\nsource = '" + fork + "'\n"))
    assertContains(quoted, fork, "a single-quoted Dang entrypoint was replaced: " + quoted)
    assertNotContains(quoted, sharedEntrypointSource, "a single-quoted Dang entrypoint was replaced: " + quoted)
    assertContainsNone(quoted, noRuntime)

    # A local client loads through serveModule under any entrypoint, so an
    # entrypoint of the user's own is kept in a scope with one too.
    let local = [ws.moduleSource("/" + clientDepPath)]
    let ownWithClient = manifestWithClients(ws.withNewFile(manifestPath, ownPath), local)
    assertContains(ownWithClient, "source = \"./my-entrypoint\"", "an entrypoint of the user's own was refused or replaced with a local client: " + ownWithClient)
    let pinnedShared = "dagger.io/sdk/python/entrypoint@v1.0.0"
    let pinnedWithClient = manifestWithClients(ws.withNewFile(manifestPath, head + "\n[entrypoint]\nkind = \"dang\"\nsource = \"" + pinnedShared + "\"\n"), local)
    assertContains(pinnedWithClient, "source = \"" + pinnedShared + "\"", "a pinned shared entrypoint was refused or replaced with a local client: " + pinnedWithClient)
    let ownWritten = manifestWithClients(ws.withNewFile(manifestPath, plain), local)
    assertContains(ownWritten, "source = \"./sdk/entrypoint\"", "the entrypoint this SDK writes was refused with a local client: " + ownWritten)

    null
  }

  """
  The released CLI lists this checkout as the python SDK, initializes a module
  from it, and runs it, on the default Python and on the SDK's floor. The
  module's manifest names the entrypoint generated into it and no runtime, so
  the module runs on code this checkout wrote.
  """
  pub cliSdkCheck(ws: Workspace!): Void @check {
    let path = ".dagger/modules/sdk-smoke"
    let listed = cli(playground(ws), ["sdk", "list"])
    assert(listed.stdout.contains("python"), "the development Python SDK was not listed")

    let initialized = cli(listed, ["module", "init", "python", "--auto-apply", "--name", "sdk-smoke", "--path", path])
      .withExec(["test", "!", "-e", path + "/dagger.json"])
      .withExec(["test", "-f", path + "/pyproject.toml"])
      .withExec(["test", "-f", path + "/src/sdk_smoke/__init__.py"])
      .withExec(["test", "-f", path + "/sdk/pyproject.toml"])
      .withExec(["test", "-f", path + "/clients/core/src/dagger_clients/core/__init__.py"])
      .withExec(["test", "!", "-e", path + "/" + legacyBindingsPath])
    let manifest = initialized.file(playgroundRoot + "/" + path + "/dagger-module.toml").contents
    assertContainsAll(manifest, ["[entrypoint]", "kind = \"dang\"", "source = \"./sdk/entrypoint\""])
    assertContainsNone(manifest, ["[runtime]", "engineVersion"])

    let release = cli(initialized, ["-m", path, "call", "container", "file", "--path", "/etc/alpine-release", "contents"])
      .stdout
    assert(release.trimSpace != "", "the generated module did not run")

    let floorPath = ".dagger/modules/sdk-floor"
    let onFloor = cli(initialized, ["module", "init", "python", "--auto-apply", "--name", "sdk-floor", "--path", floorPath, "--python-version", "3.12"])
      .withExec(["grep", "-q", ">=3.12", floorPath + "/pyproject.toml"])
    let floorRelease = cli(onFloor, ["-m", floorPath, "call", "container", "file", "--path", "/etc/alpine-release", "contents"])
      .stdout
    assert(floorRelease.trimSpace != "", "the default template did not run on the Python floor")

    cli(initialized, [
        "module", "init", "python", "--auto-apply",
        "--name", "sdk-settings",
        "--path", ".dagger/modules/sdk-settings",
        "--template", "empty",
        "--python-version", "3.13",
        "--use-uv=false",
        "--base-image", "python:3.13-slim",
      ])
      .withExec(["grep", "-q", "class SdkSettings:", ".dagger/modules/sdk-settings/src/sdk_settings/__init__.py"])
      .withExec(["grep", "-q", ">=3.13", ".dagger/modules/sdk-settings/pyproject.toml"])
      .withExec(["grep", "-q", "use-uv = false", ".dagger/modules/sdk-settings/pyproject.toml"])
      .withExec(["grep", "-q", "python:3.13-slim", ".dagger/modules/sdk-settings/pyproject.toml"])
      .sync

    null
  }

  """
  A module named with a digit or a capital runs: `dagger module init` puts its
  package where uv_build and the runtime look for it, in the shared and the
  static form, and the module still runs after `dagger generate`.
  """
  pub cliModuleNameCheck(ws: Workspace!): Void @check {
    cliModuleName(ws, "module3", "module3", false)
    cliModuleName(ws, "module3", "module3", true)
    cliModuleName(ws, "MyModule", "mymodule", true)
    null
  }

  let cliModuleName(ws: Workspace!, name: String!, pkg: String!, static: Boolean!): Void {
    let form = if (static) { "static" } else { "shared" }
    let path = ".dagger/modules/" + form + "-" + name
    let generated = cli(
      cli(playground(ws), ["module", "init", "python", "--auto-apply", "--name", name, "--path", path]),
      ["generate", "-y"],
    )
    let runnable = if (static) { generated } else { onCheckoutEntrypoint(generated, ws, path, name) }
    let ran = cli(runnable, ["-m", path, "call", "container", "file", "--path", "/etc/alpine-release", "contents"])
    assert(ran.stdout.trimSpace != "", "the " + form + " module " + name + " did not run")
    ran.withExec(["test", "-f", path + "/src/" + pkg + "/__init__.py"]).sync
    if (static) { editedBodyRuns(ran, path, pkg) } else { null }
    null
  }

  """
  A function body the module changed after generation runs as edited, with no
  second `dagger generate`: the body changes nothing types.dang describes.
  """
  let editedBodyRuns(ctr: Container!, path: String!, pkg: String!): Void {
    let sourcePath = path + "/src/" + pkg + "/__init__.py"
    let before = ctr.file(sourcePath).contents
    let edited = before.replace(
      ".with_workdir(\"/src\")",
      ".with_workdir(\"/src\")\n            .with_new_file(\"/edited\", \"body edited\")",
    )
    assert(edited != before, "the template body held nothing to edit")
    let ran = cli(ctr.withNewFile(sourcePath, edited), ["-m", path, "call", "container", "file", "--path", "/edited", "contents"])
    assert(ran.stdout.trimSpace == "body edited", "the edited body did not run: " + ran.stdout)
    null
  }

  """
  A module on an entrypoint calls a local client whose module is on an
  entrypoint too, in both forms: this checkout's shared entrypoint, and the
  one generated into the module. The released CLI drives
  it from `dagger module init` to `dagger call`.

  Under an entrypoint a module's code is not the module to the engine, and
  its own workspace is its container's: the engine serves the client's
  target from the tree the calling module was loaded from, and the target's
  entrypoint, called from that process, finds its module only in its own
  source.

  The module's code gets nothing of the caller's workspace: it tries every
  ID it holds against a file that is only in the caller's workspace, and
  reads nothing. A function that declares a Workspace parameter still gets
  the caller's, because the caller passes it.
  """
  pub entrypointClientCallCheck(ws: Workspace!): Void @check {
    entrypointClientCall(ws, "shared", "Shared")
    entrypointClientCall(ws, "static", "Static")
    null
  }

  let entrypointClientCall(ws: Workspace!, form: String!, title: String!): Void {
    let target = "ep-target-" + form
    let caller = "ep-caller-" + form
    let targetPath = ".dagger/modules/" + target
    let callerPath = ".dagger/modules/" + caller
    let greeting = "hello from the " + form + " target"
    let targetSource =
      "from dagger import function, object_type\n\n\n" +
      "@object_type\n" +
      "class EpTarget" + title + ":\n" +
      "    @function\n" +
      "    def greeting(self) -> str:\n" +
      "        return \"" + greeting + "\"\n"
    let callerSource =
      "from dagger import function, object_type\n" +
      "from dagger_clients.core import Workspace\n" +
      "from dagger_clients.ep_target_" + form + " import ep_target_" + form + "\n\n" +
      "from .reach import reach\n\n\n" +
      "@object_type\n" +
      "class EpCaller" + title + ":\n" +
      "    @function\n" +
      "    async def greeting(self) -> str:\n" +
      "        return await ep_target_" + form + "().greeting()\n\n" +
      "    @function\n" +
      "    async def reach(self) -> str:\n" +
      "        await ep_target_" + form + "().greeting()\n" +
      "        return await reach(\"" + callerSecretPath + "\")\n\n" +
      "    @function\n" +
      "    async def declared(self, ws: Workspace) -> str:\n" +
      "        return await ws.file(\"/" + callerSecretPath + "\").contents()\n"

    let withTarget = cli(playground(ws), ["module", "init", "python", "--auto-apply", "--name", target, "--path", targetPath])
      .withNewFile(targetPath + "/src/ep_target_" + form + "/__init__.py", targetSource)
    # A static entrypoint bakes the module's types, so the source is in place
    # before generation.
    let targetReady = if (form == "static") {
      cli(withTarget, ["-y", "call", "python-sdk", "mod", "--path", targetPath, "generate"])
    } else {
      onCheckoutEntrypoint(withTarget, ws, targetPath, target)
    }
    # The caller's code is in place before its client is added, so the static
    # entrypoint generated with the client describes it.
    let withClient = cli(targetReady, ["module", "init", "python", "--auto-apply", "--name", caller, "--path", callerPath])
      .withNewFile(callerPath + "/src/ep_caller_" + form + "/__init__.py", callerSource)
      .withFile(callerPath + "/src/ep_caller_" + form + "/reach.py", ws.file("/" + fixtureRoot + "/reach/reach.py"))
      .withWorkdir(callerPath)
    let added = cli(withClient, ["module", "client", "add", "../" + target, "--sdk", "python", "--auto-apply"])
      .withWorkdir(playgroundRoot)
    let callerReady = if (form == "static") { added } else { onCheckoutEntrypoint(added, ws, callerPath, caller) }
    let manifest = callerReady.file(playgroundRoot + "/" + callerPath + "/dagger-module.toml").contents
    assertContains(manifest, "[entrypoint]", form + ": the caller is not on an entrypoint: " + manifest)
    assertNotContains(manifest, "[runtime]", form + ": the caller names a runtime: " + manifest)

    # The first call is the capability probe: an engine that resolves a local
    # client in the caller's workspace, rather than in the tree the module was
    # loaded from, cannot serve the sibling this module was generated against
    # (dagger/dagger#14490). Nothing in this SDK makes that work, and the rest
    # of the check would prove nothing, so it says so and stops.
    let attempt = callerReady
      .withExec(["dagger", "-m", callerPath, "call", "greeting"], experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
    let called = attempt.stdout + attempt.stderr
    if (called.contains(ownTreeRefusal)) {
      note(callerReady, form + ": skipped, this engine resolves a local client in the caller's " +
        "workspace instead of the module's own tree (dagger/dagger#14490), so a module cannot " +
        "serve the client it was generated against")
    } else {
      assert(attempt.exitCode == 0, form + ": the module's call failed: " + called)
      assertContains(called, greeting, form + ": the module did not call its client: " + called)

      let secret = "only in the caller's workspace, " + form
      let withSecret = callerReady.withNewFile(callerSecretPath, secret)
      let reached = cli(withSecret, ["-m", callerPath, "call", "reach"]).stdout
      assertContains(reached, "reads=[]", form + ": module code read a caller file: " + reached)
      assertNotContains(reached, secret, form + ": module code read a caller file: " + reached)
      # The probe proves something only if it held an ID to try, exercised many
      # routes, and hit no unknown field: an absent route errored for the wrong
      # reason and is no evidence of safety (fixtures/reach/reach.py).
      assertNotContains(reached, "held=0 ", form + ": the module held nothing to try, so this proves nothing: " + reached)
      assertContains(reached, "absent=0 ", form + ": a probe route hit an unknown field, so it proves nothing: " + reached)
      assertNotContains(reached, "routes=0 ", form + ": the probe ran no routes: " + reached)
      let declared = cli(withSecret, ["-m", callerPath, "call", "declared"]).stdout
      assertContains(declared, secret, form + ": a declared Workspace parameter did not reach the caller's workspace: " + declared)
    }
    null
  }

  """
  What an engine says when it looks for a module where the module is not: the
  caller's workspace holds no `/<path>` for a client the module should find in
  its own tree.
  """
  let ownTreeRefusal: String! = "dir module source does not contain a dagger config file"

  """
  Say something the reader of a check's output will see. A check that stops
  because the engine cannot do what it tests must say so, not pass in silence.
  """
  let note(ctr: Container!, message: String!): Void {
    ctr.withExec(["echo", message]).stdout
    null
  }

  """
  A file at the root of the caller's workspace, outside every module's loaded files.
  """
  let callerSecretPath: String! = "review-secret.txt"

  """
  The first release that loads a module's files through its entrypoint's
  sources member. It is this SDK's floor. Its engine image carries its CLI,
  and git.
  """
  let floorVersion: String! = "1.0.0-beta.18"
  let floorImage: String! { "registry.dagger.io/engine:v" + floorVersion }

  """
  The image the playground takes its CLI from: the release of the engine
  running the check, so that the CLI it drives and the engine it reaches
  through nesting are one version. A CLI older than that engine waits for an
  answer it never gets, and the floor is proven by running these checks on the
  floor engine (engine-e2e's floorCheck), not by pinning an older CLI in here.
  An engine built from source names the release it came from before the `+`.
  """
  let playgroundImage: String! {
    "registry.dagger.io/engine:" + (version.split("+")[0] ?? version)
  }

  let playgroundRoot: String! = "/work/python-sdk"

  """
  This checkout, with the workspace config that registers it as the python
  SDK, in a container with the floor release's CLI. The CLI is a nested
  client of the engine running the checks, and its workspace is this tree.

  So the engine is whichever runs the checks. A pass proves the floor only
  on the floor's engine, which engine-e2e's floorCheck runs them on and
  asserts with assertFloorEngine; an ordinary run takes the engine it finds.
  """
  let playground(ws: Workspace!): Container! {
    playgroundOf(playgroundTree(ws))
  }

  """
  The files of a workspace that the playground mounts, with the e2e
  workspace config as its dagger.toml. The checks may run from a workspace
  whose config registers other modules, such as engine-e2e, which the
  playground's CLI would then load.
  """
  let playgroundTree(ws: Workspace!): Directory! {
    ws.directory("/", exclude: [".git", "**/.venv", "**/__pycache__", outputRoot])
      .withFile("dagger.toml", ws.file("/.dagger/modules/engine-e2e/workspace.toml"))
  }

  """
  The playground over a tree a check has changed.
  """
  let playgroundOf(tree: Directory!): Container! {
    container
      .from(playgroundImage)
      .withoutEntrypoint
      .withMountedDirectory(playgroundRoot, tree)
      .withWorkdir(playgroundRoot)
      .withExec(["git", "init", "--quiet"])
  }

  """
  floorCheck's precondition, not a check of its own: the engine the
  playground's CLI talks to is the floor release, by the version it reports
  itself. A release reports its build after a "+", which is not part of the
  version; a dev or later build is refused. engine-e2e's floorCheck calls it
  before the checks, so that check cannot pass on another engine.
  """
  pub assertFloorEngine(ws: Workspace!): Void {
    let answered = playground(ws).withExec(["dagger", "query"], stdin: "{ version }", experimentalPrivilegedNesting: true).stdout
    let reported = json.withContents((answered :: Dagger.JSON!)).field(["version"]).asString
    if ((reported.split("+")[0] ?? "") != "v" + floorVersion) {
      raise "the checks drive the floor release's CLI, v" + floorVersion + ", against the engine running them, which is " +
        reported + ": a pass would not prove the floor. Run `dagger check engine-e2e:floor-check`, which provisions its engine"
    }
    null
  }

  """
  The workspace with one fixture scope registered, as a repository that keeps
  Python modules records them. This repository's own config registers none:
  its Python scopes are fixtures, and the engine generates every registered
  scope, which would write the whole SDK into each of them.
  """
  let withScope(ws: Workspace!, path: String!, name: String!): Workspace! {
    ws.withNewFile("/dagger.toml", ws.file("/dagger.toml").contents +
      "\n[sdks.python.scopes.\"" + path + "\"]\nis-module = true\nname = \"" + name + "\"\n")
  }

  let cli(ctr: Container!, args: [String!]!): Container! {
    ctr.withExec(["dagger"] + args, experimentalPrivilegedNesting: true)
  }

  """
  A module in the playground on this checkout's shared entrypoint, not the
  published one its manifest names, which predates this layout. The copy sits
  inside the module: the engine takes an entrypoint only from a git ref or a
  path in the module.
  """
  let onCheckoutEntrypoint(ctr: Container!, ws: Workspace!, path: String!, name: String!): Container! {
    ctr
      .withDirectory(path + "/checkout-entrypoint", ws.directory("/entrypoint"))
      .withNewFile(path + "/dagger-module.toml", "name = \"" + name + "\"\n\n[entrypoint]\nkind = \"dang\"\nsource = \"./checkout-entrypoint\"\n")
  }

  """
  runtime/build.dang as the shared entrypoint carries it.

  The engine copies only the .dang files at the top of an entrypoint
  directory, and `currentModule` inside an entrypoint is the module it serves,
  so a shared entrypoint can read none of its own non-Dang files. The externals
  block that reads the pinned Dockerfiles is written out here instead, the same
  way a generated per-module entrypoint carries it.
  """
  pub sharedEntrypointBuild(ws: Workspace!): File! {
    let pins = "let defaultBaseImage: String! = \"" + imageFrom(ws, "runtime/images/base/Dockerfile") + "\"\n" +
      "  let defaultUvImage: String! = \"" + imageFrom(ws, "runtime/images/uv/Dockerfile") + "\""
    let inlined = ws.file("/runtime/build.dang").contents
      .replaceMatches("(?s)#<externals>.*?#</externals>", pins)
    if (inlined.contains("currentModule")) {
      raise "runtime/build.dang reads currentModule outside its externals block"
    } else {
      directory
        .withNewFile(sharedEntrypointBuildPath, sharedEntrypointHeader + inlined)
        .file(sharedEntrypointBuildPath)
    }
  }

  let sharedEntrypointBuildPath: String! = "entrypoint/build.dang"

  let sharedEntrypointHeader: String! =
    "# Generated from runtime/build.dang by the e2e module. DO NOT EDIT.\n" +
    "#\n" +
    "# Refresh with:\n" +
    "#   dagger call -m .dagger/modules/e2e shared-entrypoint-build \\\n" +
    "#     export --path " + "entrypoint/build.dang" + "\n" +
    "\n"

  let imageFrom(ws: Workspace!, path: String!): String! {
    let line = ws.file("/" + path).contents.match("(?m)^FROM\\s+(\\S+)")
    if (line == null) {
      raise "no FROM line in " + path
    } else {
      line.captures[0] ?? ""
    }
  }

  """
  The committed copy of the build in the shared entrypoint matches the runtime
  module's, so a Dependabot bump to a pinned image reaches both.
  """
  pub sharedEntrypointBuildCheck(ws: Workspace!): Void @check {
    let want = sharedEntrypointBuild(ws).contents
    let got = ws.file("/" + sharedEntrypointBuildPath).contents
    assert(
      got == want,
      sharedEntrypointBuildPath + " is stale; refresh it with `dagger call -m .dagger/modules/e2e shared-entrypoint-build export --path " + sharedEntrypointBuildPath + "`",
    )
    null
  }

  """
  Main object names derive from module names as in the engine's builtin Python
  runtime, so a module keeps loading when it moves between the two.
  """
  pub runtimeNamingCheck: Void @check {
    [
      ["my-module", "MyModule"],
      ["my_module", "MyModule"],
      ["myModule", "MyModule"],
      ["MyModule", "MyModule"],
      ["HTTPServer", "Httpserver"],
      ["s3-bucket", "S3Bucket"],
      ["app2", "App2"],
      ["a.b c", "ABC"],
    ].each { pair =>
      let name = pair[0] ?? ""
      let want = pair[1] ?? ""
      let got = pythonSdkRuntime.mainObjectName(name)
      assert(got == want, "main object name for " + name + ": got " + got + ", want " + want)
    }

    null
  }

  let sdkSource(ws: Workspace!): Directory! {
    ws
      .directory("/", include: ["sdk/**", "!sdk/**/.venv", "!sdk/**/__pycache__"])
      .directory("sdk")
  }

  let sdkBase(python: String!): Container! {
    container
      .from("ghcr.io/astral-sh/uv:python" + python + "-alpine")
      .withoutEntrypoint
      # The image's Python, not the one sdk/.python-version names.
      .withEnvVariable("UV_PYTHON", python)
      .withEnvVariable("UV_PYTHON_DOWNLOADS", "never")
      .withMountedCache("/root/.cache/uv", cacheVolume("python-sdk-uv"))
  }

  let sdkContainer(ws: Workspace!, python: String! = "3.14"): Container! {
    sdkBase(python)
      .withDirectory("/sdk", sdkSource(ws))
      .withWorkdir("/sdk")
  }

  """
  The client library and code generator pass their own suites: the query
  builder, generator output and module registration.
  """
  pub sdkTestCheck(ws: Workspace!): Void @check {
    sdkTests(ws, "3.14")
  }

  """
  A scope may run the SDK on any Python from its floor up, so the suites run on
  the floor too. It is read from sdk/pyproject.toml so the check follows a
  floor change.
  """
  pub sdkTestOldestPythonCheck(ws: Workspace!): Void @check {
    let floor = ws.file("/sdk/pyproject.toml").contents.match("(?m)^requires-python = \">=([0-9.]+)\"")
    if (floor == null) {
      raise "sdk/pyproject.toml declares no requires-python floor"
    } else {
      sdkTests(ws, floor.captures[0] ?? "")
    }
  }

  """
  A module can ask for the newest Python release before the SDK's default
  moves to it, so the suites run there too.
  """
  pub sdkTestNewestPythonCheck(ws: Workspace!): Void @check {
    sdkTests(ws, "3.15")
  }

  let sdkTests(ws: Workspace!, python: String!): Void {
    pytest(base: sdkBase(python), args: ["-q", "tests/client", "tests/codegen", "tests/mod"])
      .project(ws, "sdk")
      .test(ws)
  }

  """
  The client bindings this repository's tests import, as the code generator
  writes them from core and sdk/ruff.toml tidies them. Core is read the way a
  scope reads it, from the engine running this. The committed file is the
  floor release's core; refresh it on that engine:

    dagger call -m .dagger/modules/e2e sdk-bindings export --path sdk/src/dagger/client/gen.py
  """
  pub sdkBindings(ws: Workspace!): File! {
    let core = ws.directory("/helpers/core-schema").asModuleSource
    sdkContainer(ws)
      .withFile("/core-only.py", ws.file("/helpers/core-schema/core_only.py"))
      .withFile("/schema.json", core.withEngineVersion(core.engineVersion).clientSchemaIntrospectionJSON)
      .withExec(["python", "/core-only.py", "/schema.json", "/core.json"])
      .withExec(["uv", "run", "--frozen", "python", "-m", "codegen", "generate", "-i", "/core.json", "-o", sdkBindingsPath])
      .withExec(["uv", "run", "--frozen", "ruff", "check", "--fix-only", sdkBindingsPath])
      .withExec(["uv", "run", "--frozen", "ruff", "format", sdkBindingsPath])
      .file(sdkBindingsPath)
  }

  let sdkBindingsPath: String! = "src/dagger/client/gen.py"

  """
  The committed client bindings are what sdkBindings writes, so neither a
  hand edit nor a new core leaves them behind. Each release serves a core of
  its own, so only the floor release's engine can tell.
  """
  pub sdkBindingsCheck(ws: Workspace!): Void @check {
    let path = "sdk/" + sdkBindingsPath
    if ((version.split("+")[0] ?? version) != "v" + floorVersion) {
      note(sdkContainer(ws), "skipped, " + path + " is the core of v" + floorVersion + " and this engine is " + version)
    } else {
      assert(
        ws.file("/" + path).contents == sdkBindings(ws).contents,
        path + " is not what the code generator writes; refresh it on the v" + floorVersion +
          " engine with `dagger call -m .dagger/modules/e2e sdk-bindings export --path " + path + "`",
      )
    }
    null
  }

  """
  config.get should reflect pyproject.toml and report unset values as null
  rather than guessing, and config.set should edit only pyproject.toml.
  """
  pub configCheck(scope: Workspace!): Void @check {
    let ws = withScope(withScope(scope, configModulePath, "config-app"), configuredModulePath, "config-configured")
    let app = pythonSdk.mod(ws, path: configModulePath).config
    let configured = pythonSdk.mod(ws, path: configuredModulePath).config

    let appValues = app.get
    assert(appValues.pythonVersion == "3.14", "default pythonVersion should read 3.14")
    assert(appValues.useUv == null, "useUv should be reported as unset, not guessed")
    assert(appValues.baseImage == null, "baseImage should be reported as unset")

    let configuredValues = configured.get
    assert(configuredValues.pythonVersion == "3.12", "configured pythonVersion should read 3.12")
    assert(configuredValues.useUv == false, "configured useUv should read false")
    assert(configuredValues.baseImage == "python:3.12-slim", "configured baseImage should read the override")

    let pyproj = configModulePath + "/pyproject.toml"

    let py = app.set(pythonVersion: "3.13")
    assert(contains(py.modifiedPaths, pyproj), "set should modify pyproject.toml")
    assert(py.modifiedPaths.length == 1, "set modified more than pyproject.toml")
    assert(py.addedPaths.length == 0, "set should not add files")
    assertContains(py.after.file(pyproj).contents, ">=3.13", "set did not write the new python version")
    assertContains(py.after.file(pyproj).contents, "dagger-io", "set dropped unrelated keys")

    let multi = app.set(pythonVersion: "3.13", useUv: false, baseImage: "python:3.13-slim")
    assert(multi.modifiedPaths.length == 1, "multi-value set modified more than pyproject.toml")
    assert(multi.addedPaths.length == 0, "multi-value set should not add files")
    assertContains(multi.after.file(pyproj).contents, ">=3.13", "multi-value set did not write python version")
    assertContains(multi.after.file(pyproj).contents, "use-uv = false", "multi-value set did not write use-uv")
    assertContains(multi.after.file(pyproj).contents, "python:3.13-slim", "multi-value set did not write base image")

    let configuredPyproj = configuredModulePath + "/pyproject.toml"
    let partial = configured.set(pythonVersion: "3.13")
    assertContains(partial.after.file(configuredPyproj).contents, ">=3.13", "partial set did not update python version")
    assertContains(partial.after.file(configuredPyproj).contents, "use-uv = false", "omitting useUv should leave it untouched")
    assertContains(partial.after.file(configuredPyproj).contents, "python:3.12-slim", "omitting baseImage should leave it untouched")

    # The global client flag reads and writes like use-uv: unset is null, and
    # false, the default, writes nothing.
    assert(appValues.globalClient == null, "globalClient should be reported as unset")
    let on = app.set(globalClient: true)
    assert(on.modifiedPaths.length == 1, "setting globalClient modified more than pyproject.toml")
    assertContains(on.after.file(pyproj).contents, "global-client = true", "set did not write the global client flag")
    let onWs = ws.withChanges(on)
    assert(pythonSdk.mod(onWs, path: configModulePath).config.get.globalClient == true, "globalClient should read true once set")
    let off = pythonSdk.mod(onWs, path: configModulePath).config.set(globalClient: false)
    assertNotContains(off.after.file(pyproj).contents, "global-client", "setting globalClient to false should remove the flag")
    assert(off.after.file(pyproj).contents == on.before.file(pyproj).contents, "setting globalClient true then false changed more than the flag")

    null
  }


  """
  Whether a cache policy reaches the exec an entrypoint starts: the answers of
  a `cache="never"` function twice over, then of a plain one twice over. The
  first pair differs and the second does not once the engine passes callDigest
  (dagger/dagger#14491).

  No `@check`: it needs such an engine, and a CLI of that engine's own version
  in the playground, which engineImage names.

      dagger call -m .dagger/modules/e2e cache-policy-probe --engine-image registry.dagger.io/engine:v<version>
  """
  pub cachePolicyProbe(ws: Workspace!, engineImage: String! = ""): String! {
    let path = ".dagger/modules/cache-probe"
    let source = "import time\n\nfrom dagger import function, object_type\n\n\n@object_type\nclass CacheProbe:\n" +
      "    @function\n    def plain(self) -> str:\n        return str(time.time_ns())\n\n" +
      "    @function(cache=\"never\")\n    def never(self) -> str:\n        return str(time.time_ns())\n"
    let image = if (engineImage == "") { playgroundImage } else { engineImage }
    let base = container
      .from(image)
      .withoutEntrypoint
      .withMountedDirectory(playgroundRoot, playgroundTree(ws))
      .withWorkdir(playgroundRoot)
      .withExec(["git", "init", "--quiet"])
    let ready = cli(
      cli(base, ["module", "init", "python", "--auto-apply", "--name", "cache-probe", "--path", path])
        .withNewFile(path + "/src/cache_probe/__init__.py", source),
      ["generate", "-y"],
    )
    # One env variable per answer: two identical execs here would be one.
    let answer(fn: String!, run: String!): String! {
      cli(ready.withEnvVariable("E2E_PROBE_RUN", run), ["-m", path, "call", fn]).stdout.trimSpace
    }
    "never: " + answer("never", "1") + " " + answer("never", "2") +
      ", plain: " + answer("plain", "3") + " " + answer("plain", "4")
  }

  """
  A static entrypoint scope: the entrypoint manifest, the template, bindings
  from the current schema view, and the generated entrypoint, which builds the
  module from its own source.
  """
  pub staticScopeInitCheck(ws: Workspace!): Void @check {
    let scope = outputRoot + "/static-init"
    let scoped = ws.withNewDirectory("/" + scope, directory).withWorkdir(scope)
    let generated = pythonSdk.generateScope(scoped, isModule: true, name: "static-init", clients: [])
    let changes = generated.withWorkdir(".").changes(scoped.withWorkdir("."))

    assert(generated.cwd == scoped.cwd, "generateScope must not change the workspace cwd")
    let manifest = changes.layer.file(scope + "/dagger-module.toml").contents
    assert(
      manifest == "name = \"static-init\"\n\n[entrypoint]\n  kind = \"dang\"\n  source = \"./sdk/entrypoint\"\n",
      "unexpected static manifest: " + manifest,
    )
    assertAdded(changes, scope + "/src/static_init/__init__.py")
    # Fields the oldest schema view lacks: core came from the current one.
    assertContainsAll(changes.layer.file(scope + "/" + coreInitPath).contents, ["def cwd(", "def with_new_file("])

    let main = changes.layer.file(scope + "/sdk/entrypoint/main.dang").contents
    assertContainsAll(main, [
      "implements ModuleEntrypoint",
      "let moduleName: String! = \"static-init\"",
      "pub sources(workspace: Workspace!): Directory! {",
      "pub types: [TypeDef!]! {",
      "contextDir: directory.withDirectory(\".\", currentModule.contextDirectory",
    ])
    assertNotContains(main, "workspace.id", "the static entrypoint hands the module the caller's workspace")
    assertNotContains(main, "clients:", "the static entrypoint still hands the module its clients")
    # Found through its own source, so a moved module needs no regeneration.
    assertNotContains(main, "modulePath", "the entrypoint still finds the module through the workspace")
    # No staleness guard: an edit that leaves the described types alone runs
    # without another `dagger generate`.
    assertContainsNone(main, ["SourceFile", "sourceFiles", "skippedDirs", "changed since its entrypoint"])
    let types = changes.layer.file(scope + "/sdk/entrypoint/types.dang").contents
    assertContainsAll(types, ["typeDef.withObject(\"StaticInit\"", "function(\"container\"", "withConstructor("])
    assertContainsNone(types, ["withField(", "withCachePolicy("])
    let build = changes.layer.file(scope + "/sdk/entrypoint/build.dang").contents
    assertContainsAll(build, ["type PythonModuleBuild", "let defaultBaseImage: String! = \"python:", "let defaultUvImage: String! = \"ghcr.io/astral-sh/uv:"])
    assertNotContains(build, "currentModule", "build.dang still reads the SDK module's source")

    null
  }

  """
  The SDK refuses an engine release older than its floor before it generates
  anything, and names the version it found and what to do: pin the SDK's last
  release before the floor where that release runs, from v1.0.0-beta.14, and
  only upgrade below it. Every other version passes, a development build and
  one it cannot read among them, so an unexpected format never blocks a user.
  On an engine the SDK refuses, generation itself refuses.
  """
  pub engineFloorRefusalCheck(ws: Workspace!): Void @check {
    let pin = "dagger module install github.com/dagger/python-sdk@v1.1.1"
    let pinned = ["v1.0.0-beta.17", "v1.0.0-beta.17+0da36c8d", "v1.0.0-beta.16", "v1.0.0-beta.15", "v1.0.0-beta.14", "v1.0.0-beta.14+06660c3c"]
    let upgradeOnly = ["v1.0.0-beta.13", "v1.0.0-beta.9", "v1.0.0-alpha.20", "v0.21.9"]
    let accepted = [
      "v1.0.0-beta.18", "v1.0.0-beta.18+249edbd6", "v1.0.0-beta.19", "v1.0.0-rc.1", "v1.0.0",
      "v1.0.1", "v2.0.0-beta.1", "v0.21.1-20260529020034-dev-b2f595b50044", "v1.0.0-dev.3", "devel", "",
    ]
    (pinned + upgradeOnly).each { engine =>
      let refusal = pythonSdk.engineRefusal(engine)
      let wants = ["needs Dagger engine v" + floorVersion + " or later", "this engine is " + engine + ".", "Upgrade the engine"]
      wants.each { want =>
        assertContains(refusal, want, "engine \"" + engine + "\": the refusal does not say \"" + want + "\": " + refusal)
      }
    }
    pinned.each { engine =>
      let refusal = pythonSdk.engineRefusal(engine)
      assertContains(refusal, pin, "engine \"" + engine + "\": the refusal does not offer the last release that runs on it: " + refusal)
    }
    upgradeOnly.each { engine =>
      let refusal = pythonSdk.engineRefusal(engine)
      assertNotContains(refusal, "pin", "engine \"" + engine + "\": the refusal offers a release that does not run on it either: " + refusal)
    }
    accepted.each { engine =>
      let refusal = pythonSdk.engineRefusal(engine)
      assert(refusal == "", "the SDK refused engine \"" + engine + "\": " + refusal)
    }
    let refusal = pythonSdk.engineRefusal(version)
    if (refusal != "") {
      let said = pythonSdk.generateScope(ws.withNewDirectory("/floor-probe", directory).withWorkdir("floor-probe"), isModule: true, name: "floor-probe", clients: []).cwd rescue {
        err: Error => err.message
      }
      assert(said.contains(refusal), "generation on engine " + version + ", which the SDK refuses, said: " + said)
    }
    null
  }

  """
  A module declares a collection, on this checkout's shared entrypoint, on
  the one generated into it, and on this checkout's runtime, which registers
  the types itself. The engine serves keys, list, get, subset and batch on it,
  and the CLI names an item with a selector, after the collection or in place
  of the path to it.

  A copy the module returns keeps the collection's base, so its delta compares
  it with the keys the module first returned; a new collection starts a base
  of its own. Without that state a changed copy reads as unchanged.
  """
  pub collectionsCheck(ws: Workspace!): Void @check {
    collections(ws, "shared")
    collections(ws, "static")
    collections(ws, "runtime")
    null
  }

  """
  A module calls the collection through the client generated from it. keys,
  get, list, subset and batch exist only in the engine's projection of the
  collection, so the client has them only if it was generated from that.
  """
  pub collectionsClientCheck(ws: Workspace!): Void @check {
    let target = ".dagger/modules/shelf"
    let caller = ".dagger/modules/shelf-caller"
    let targetReady = cli(
      cli(playground(ws), ["module", "init", "python", "--auto-apply", "--name", "shelf", "--path", target])
        .withFile(target + "/src/shelf/__init__.py", ws.file("/" + fixtureRoot + "/collections/shelf.py")),
      ["generate", "-y"],
    )
    let withCaller = cli(targetReady, ["module", "init", "python", "--auto-apply", "--name", "shelf-caller", "--path", caller])
      .withFile(caller + "/src/shelf_caller/__init__.py", ws.file("/" + fixtureRoot + "/collections/caller.py"))
      .withWorkdir(caller)
    let callerReady = cli(withCaller, ["module", "client", "add", "../shelf", "--sdk", "python", "--auto-apply"])
      .withWorkdir(playgroundRoot)
    let attempt = callerReady
      .withExec(["dagger", "-m", caller, "call", "report"], experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
    let called = attempt.stdout + attempt.stderr
    if (called.contains(ownTreeRefusal)) {
      note(callerReady, "skipped, this engine resolves a local client in the caller's workspace " +
        "instead of the module's own tree (dagger/dagger#14490)")
    } else {
      assert(attempt.exitCode == 0, "the caller's call failed: " + called)
      let want = "keys=['b', 'a', 'c'] list=['item:b', 'item:a', 'item:c'] get=item:a removed=['b', 'a']"
      assertContains(attempt.stdout, want, "the client did not reach the projected collection: " + called)
    }
    null
  }

  let collections(ws: Workspace!, form: String!): Void {
    let path = ".dagger/modules/shelf"
    let initialized = cli(playground(ws), ["module", "init", "python", "--auto-apply", "--name", "shelf", "--path", path])
      .withFile(path + "/src/shelf/__init__.py", ws.file("/" + fixtureRoot + "/collections/shelf.py"))
    # A static entrypoint bakes the module's types, so the source is in place
    # before generation.
    let ready = if (form == "static") {
      cli(initialized, ["generate", "-y"])
    } else if (form == "runtime") {
      initialized.withNewFile(path + "/dagger-module.toml",
        "name = \"shelf\"\nengineVersion = \"v1.0.0-0\"\n\n[runtime]\nsource = \"../../../runtime\"\n")
    } else {
      onCheckoutEntrypoint(initialized, ws, path, "shelf")
    }

    let queried = ready
      .withExec(["dagger", "-m", path, "query"], stdin: collectionQuery, experimentalPrivilegedNesting: true)
      .stdout
    let compact = queried.replace(" ", "").replace("\n", "")
    assert(compact == collectionAnswer, form + ": the collection API answered " + compact + ", not " + collectionAnswer)

    let item = cli(ready, ["-m", path, "call", "items", "name", "--shelf-item=a"]).stdout
    assert(item.trimSpace == "item:a", form + ": the selector after the collection did not name item a: " + item)
    let rooted = cli(ready, ["-m", path, "call", "--shelf-item=c", "name"]).stdout
    assert(rooted.trimSpace == "item:c", form + ": the selector in place of the path did not name item c: " + rooted)
    let batch = cli(ready, ["-m", path, "call", "items", "selected", "--shelf-item=c", "--shelf-item=b"]).stdout
    assert(batch.trimSpace == "b\nc", form + ": repeated selectors did not reach the batch with b and c: " + batch)
    null
  }

  """
  A module still loads on this checkout's shared entrypoint when its SDK
  predates collections. The module keeps the SDK it was generated with while
  the shared entrypoint moves with its tag, so the description it reads can
  lack every collection key: the check strips them from the module's own
  description, as that older SDK writes it.
  """
  pub collectionsOlderSdkCheck(ws: Workspace!): Void @check {
    let path = ".dagger/modules/older-sdk"
    let describe = path + "/sdk/src/dagger/mod/_describe.py"
    let initialized = cli(playground(ws), ["module", "init", "python", "--auto-apply", "--name", "older-sdk", "--path", path])
    let source = initialized.file(playgroundRoot + "/" + describe).contents
    let older = source.replace(describeJSONReturn, olderDescribeJSONReturn)
    assert(older != source, "the SDK has no describe_json return to rewrite")
    let ready = onCheckoutEntrypoint(initialized.withNewFile(describe, older), ws, path, "older-sdk")
    let ran = cli(ready, ["-m", path, "call", "container", "file", "--path", "/etc/alpine-release", "contents"]).stdout
    assert(ran.trimSpace != "", "a module on an SDK older than collections did not run on the shared entrypoint")
    null
  }

  let describeJSONReturn: String! = "    return json.dumps(dataclasses.asdict(desc))\n"

  let olderDescribeJSONReturn: String! = "    def older(value):\n" +
    "        if isinstance(value, dict):\n" +
    "            return {k: older(v) for k, v in value.items() if not k.startswith(\"collection\")}\n" +
    "        if isinstance(value, (list, tuple)):\n" +
    "            return [older(v) for v in value]\n" +
    "        return value\n" +
    "\n" +
    "    return json.dumps(older(dataclasses.asdict(desc)))\n"

  let collectionQuery: String! = "{ items {\n" +
    "  keys\n" +
    "  list { name }\n" +
    "  get(key: \"a\") { name }\n" +
    "  batch { selected removed }\n" +
    "  subset(keys: [\"c\", \"b\"]) { keys batch { selected removed } }\n" +
    "  changed: batch { change(names: [\"c\", \"d\"]) { keys batch { added removed } } }\n" +
    "  fresh: subset(keys: [\"c\"]) { batch { fresh { keys batch { added removed } } } }\n" +
    "} }"

  """The answer to collectionQuery, with its keys sorted the way the CLI prints them."""
  let collectionAnswer: String! = "{\"items\":{" +
    "\"batch\":{\"removed\":[],\"selected\":[\"b\",\"a\",\"c\"]}," +
    "\"changed\":{\"change\":{\"batch\":{\"added\":[\"d\"],\"removed\":[\"b\",\"a\"]},\"keys\":[\"c\",\"d\"]}}," +
    "\"fresh\":{\"batch\":{\"fresh\":{\"batch\":{\"added\":[],\"removed\":[]},\"keys\":[\"z\"]}}}," +
    "\"get\":{\"name\":\"item:a\"}," +
    "\"keys\":[\"b\",\"a\",\"c\"]," +
    "\"list\":[{\"name\":\"item:b\"},{\"name\":\"item:a\"},{\"name\":\"item:c\"}]," +
    "\"subset\":{\"batch\":{\"removed\":[\"a\"],\"selected\":[\"b\",\"c\"]},\"keys\":[\"b\",\"c\"]}" +
    "}}"


  """
  Collections of every key type the engine takes, in one module: Int, Float,
  Boolean, an enum and a core scalar. The delta names a removed key as text,
  whatever the key type. An item can be a collection itself. A batch
  generator replaces its item's generator of the same name and sees only the
  selected keys; the item's generator raises if it runs.
  """
  pub collectionKindsCheck(ws: Workspace!): Void @check {
    let path = ".dagger/modules/kinds"
    let initialized = cli(playground(ws), ["module", "init", "python", "--auto-apply", "--name", "kinds", "--path", path])
      .withFile(path + "/src/kinds/__init__.py", ws.file("/" + fixtureRoot + "/collections/kinds.py"))
    let ready = onCheckoutEntrypoint(initialized, ws, path, "kinds")

    let queried = ready
      .withExec(["dagger", "-m", path, "query"], stdin: kindsQuery, experimentalPrivilegedNesting: true)
      .stdout
    let compact = queried.replace(" ", "").replace("\n", "")
    assert(compact == kindsAnswer, "the collections answered " + compact + ", not " + kindsAnswer)

    let generated = cli(ready, ["-m", path, "generate", "-y", "items/write?kinds-items-item=a&kinds-items-item=b"])
    let selected = generated.withExec(["cat", playgroundRoot + "/selected"]).stdout
    assert(selected == "a,b", "the batch generator wrote " + selected + ", not the selected keys a,b")
    null
  }

  let kindsQuery: String! = "{\n" +
    "  numbers { keys get(key: 2) { name } subset(keys: [3, 1]) { keys batch { removed } } }\n" +
    "  ratios { keys get(key: 1.5) { name } subset(keys: [1.5]) { batch { removed } } }\n" +
    "  flags { keys get(key: false) { name } subset(keys: [false]) { batch { removed } } }\n" +
    "  colors { keys get(key: BLUE) { name } subset(keys: [BLUE]) { batch { removed } } }\n" +
    "  platforms { keys get(key: \"linux/arm64\") { name } subset(keys: [\"linux/arm64\"]) { batch { removed } } }\n" +
    "  items { keys batch { selected } }\n" +
    "  shelves { keys get(key: \"s2\") { keys get(key: \"s2-1\") { name } subset(keys: [\"s2-2\"]) { batch { selected } } } subset(keys: [\"s1\"]) { batch { count } } }\n" +
    "}"

  """The answer to kindsQuery, with its keys sorted the way the CLI prints them."""
  let kindsAnswer: String! = "{" +
    "\"colors\":{\"get\":{\"name\":\"blue\"},\"keys\":[\"RED\",\"BLUE\"],\"subset\":{\"batch\":{\"removed\":[\"RED\"]}}}," +
    "\"flags\":{\"get\":{\"name\":\"fFalse\"},\"keys\":[true,false],\"subset\":{\"batch\":{\"removed\":[\"true\"]}}}," +
    "\"items\":{\"batch\":{\"selected\":[\"a\",\"b\",\"c\"]},\"keys\":[\"a\",\"b\",\"c\"]}," +
    "\"numbers\":{\"get\":{\"name\":\"n2\"},\"keys\":[2,1,3],\"subset\":{\"batch\":{\"removed\":[\"2\"]},\"keys\":[1,3]}}," +
    "\"platforms\":{\"get\":{\"name\":\"linux/arm64\"},\"keys\":[\"linux/amd64\",\"linux/arm64\"],\"subset\":{\"batch\":{\"removed\":[\"linux/amd64\"]}}}," +
    "\"ratios\":{\"get\":{\"name\":\"r1.5\"},\"keys\":[0.5,1.5],\"subset\":{\"batch\":{\"removed\":[\"0.5\"]}}}," +
    "\"shelves\":{\"get\":{\"get\":{\"name\":\"s2-1\"},\"keys\":[\"s2-1\",\"s2-2\"],\"subset\":{\"batch\":{\"selected\":[\"s2-2\"]}}},\"keys\":[\"s1\",\"s2\"],\"subset\":{\"batch\":{\"count\":1}}}" +
    "}"

  """
  A module keeps the kind of entrypoint its manifest names when it is
  generated again: one written into it stays written into it, and a Dang
  entrypoint of another kind, a fork say, is left as it is. A second
  generation changes nothing either way.
  """
  pub entrypointKindCheck(ws: Workspace!): Void @check {
    let manifestPath = tomlGenerateModulePath + "/dagger-module.toml"
    let entrypointPath = tomlGenerateModulePath + "/sdk/entrypoint"
    let name = "toml-generate-app"

    let generated = pythonSdk.generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    let written = generated.changes(ws)
    let switched = written.after.file(manifestPath).contents
    assertContains(switched, "source = \"./sdk/entrypoint\"", "a module was not given an entrypoint of its own")
    assertNotContains(switched, "manifestVersion", "the entrypoint manifest carries a manifestVersion the engine refuses")
    ["main.dang", "types.dang", "build.dang"].each { file => assertAdded(written, entrypointPath + "/" + file) }
    assert(written.modifiedPaths.filter { path => path.hasPrefix(tomlGenerateModulePath + "/src/") }.length == 0, "generating touched user files")

    # The manifest is read as TOML, so a single-quoted name is the same name
    # to a module generated directly.
    let singleQuoted = switched.replace("name = \"" + name + "\"", "name = '" + name + "'")
    assert(singleQuoted != switched, "the entrypoint manifest had no double-quoted name to rewrite")
    let direct = pythonSdk.mod(generated.withNewFile("/" + manifestPath, singleQuoted), path: tomlGenerateModulePath, findUp: false).generated
    assertContains(direct.file("/" + manifestPath).contents, "name = \"" + name + "\"", "a single-quoted module name was not read")

    let again = pythonSdk.generateScope(generated.withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    assert(again.changes(generated).isEmpty, "a second generation changed a module with its own entrypoint")

    # A Dang entrypoint of another kind is the user's: it stays, and nothing
    # is written into the module for it.
    let fork = "github.com/dagger/python-sdk/entrypoint@v1.2.3"
    let forked = ws.withNewFile("/" + manifestPath, "name = \"" + name + "\"\n\n[entrypoint]\nkind = \"dang\"\nsource = \"" + fork + "\"\n")
    let keptFork = pythonSdk.generateScope(forked.withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    let forkManifest = keptFork.file("/" + manifestPath).contents
    assertContains(forkManifest, fork, "a Dang entrypoint of the user's own was replaced: " + forkManifest)
    assert(keptFork.directory("/" + tomlGenerateModulePath).exists("sdk/entrypoint") == false, "a module on another entrypoint got one written into it")

    null
  }

  """
  `--legacy-runtime` runs a module on the runtime this SDK publishes instead of
  an entrypoint: a new module names it, a module that carries an entrypoint of
  its own moves onto it and the entrypoint goes, and a module on a runtime of
  the user's own keeps theirs. The flag cannot be combined with
  `--remote-entrypoint`. The module runs, which the check proves through this
  checkout's runtime: the published reference the SDK writes resolves to a tag,
  and that tag moves only with a release.
  """
  pub legacyRuntimeCheck(ws: Workspace!): Void @check {
    let manifestPath = "/" + tomlGenerateModulePath + "/dagger-module.toml"
    let name = "toml-generate-app"
    let scoped = ws.withWorkdir(tomlGenerateModulePath)
    let runtime = pythonSdk(legacyRuntime: true)

    let fresh = runtime.generateScope(scoped, isModule: true, name: name, clients: []).withWorkdir(".")
    let freshManifest = fresh.file(manifestPath).contents
    assertContainsAll(freshManifest, ["[runtime]", "source = \"" + sdkRuntimeSource + "\"", "engineVersion"])
    assertNotContains(freshManifest, "[entrypoint]", "a module asked for the runtime got an entrypoint")
    assert(fresh.directory("/" + tomlGenerateModulePath).exists("sdk/entrypoint") == false, "a module on the runtime got an entrypoint of its own")
    assertScopeTree(fresh, tomlGenerateModulePath)

    # A module with an entrypoint of its own moves onto the runtime, and the
    # files of the entrypoint go with the move.
    let generated = pythonSdk.generateScope(scoped, isModule: true, name: name, clients: []).withWorkdir(".")
    assert(generated.directory("/" + tomlGenerateModulePath).exists("sdk/entrypoint"), "a module was not given an entrypoint of its own")
    let moved = runtime.generateScope(generated.withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    assertContains(moved.file(manifestPath).contents, "source = \"" + sdkRuntimeSource + "\"", "the flag did not move the module onto the runtime")
    assertNotContains(moved.file(manifestPath).contents, "[entrypoint]", "the entrypoint table survived the move to a runtime")
    assert(moved.directory("/" + tomlGenerateModulePath).exists("sdk/entrypoint") == false, "moving onto the runtime left the entrypoint behind")

    # A runtime of the user's own is theirs, flag or no flag.
    let ownRuntime = "name = \"" + name + "\"\nengineVersion = \"v1.0.0-0\"\n\n[runtime]\nsource = \"../../../../../../runtime\"\n"
    let kept = runtime
      .generateScope(ws.withNewFile(manifestPath, ownRuntime).withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: [])
      .withWorkdir(".")
    assertContains(kept.file(manifestPath).contents, "source = \"../../../../../../runtime\"", "the flag took a runtime of the user's own away")

    # The two flags ask for two runners.
    let both = pythonSdk(legacyRuntime: true, remoteEntrypoint: true)
      .generateScope(scoped, isModule: true, name: name, clients: [])
      .cwd rescue {
        err: Error => err.message
      }
    assertContainsAll(both, ["--remote-entrypoint", "--legacy-runtime", "cannot be set together"])

    # It runs: the same scope, with this checkout's runtime in place of the
    # published reference, called through the floor release's CLI.
    let onCheckout = fresh.withNewFile(manifestPath, runtimeOnlyManifest(name))
    let called = cli(playground(onCheckout), ["-m", tomlGenerateModulePath, "call", "hello"]).stdout
    assertContains(called, "hello", "the module did not run on the runtime: " + called)

    null
  }

  """
  `--remote-entrypoint` puts a module on the entrypoint this SDK publishes:
  a new module names it instead of one of its own, a module that has one of
  its own moves onto it and the files go, and a module on a runtime of its own
  keeps the runtime.
  """
  pub remoteEntrypointCheck(ws: Workspace!): Void @check {
    let manifestPath = "/" + tomlGenerateModulePath + "/dagger-module.toml"
    let name = "toml-generate-app"
    let remote = pythonSdk(remoteEntrypoint: true)

    let fresh = remote.generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    assertContains(fresh.file(manifestPath).contents, "source = \"" + sharedEntrypointSource + "\"", "a module did not name the published entrypoint")
    assert(fresh.directory("/" + tomlGenerateModulePath).exists("sdk/entrypoint") == false, "a module on the published entrypoint got one of its own")

    let generated = pythonSdk.generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    assert(generated.directory("/" + tomlGenerateModulePath).exists("sdk/entrypoint"), "a module was not given an entrypoint of its own")
    let moved = remote.generateScope(generated.withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    assertContains(moved.file(manifestPath).contents, "source = \"" + sharedEntrypointSource + "\"", "the flag did not move the module onto the published entrypoint")
    assert(moved.directory("/" + tomlGenerateModulePath).exists("sdk/entrypoint") == false, "moving onto the published entrypoint left the files behind")
    assert(moved.changes(fresh).isEmpty, "a module moved onto the published entrypoint differs from one generated on it")

    # A runtime of the user's own is theirs to remove, so the flag leaves it.
    let ownRuntime = "name = \"" + name + "\"\nengineVersion = \"v1.0.0-0\"\n\n[runtime]\nsource = \"../../../../../../runtime\"\n"
    let kept = remote.generateScope(ws.withNewFile(manifestPath, ownRuntime).withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).withWorkdir(".")
    let keptManifest = kept.file(manifestPath).contents
    assertContains(keptManifest, "source = \"../../../../../../runtime\"", "the flag took a runtime of the user's own away: " + keptManifest)
    assertNotContains(keptManifest, "[entrypoint]", "the flag put an entrypoint in front of the user's own runtime")

    null
  }

  """
  The static path refuses what an entrypoint manifest cannot carry, before
  writing anything.
  """
  pub staticScopeRefusalsCheck(ws: Workspace!): Void @check {
    let static = pythonSdk
    let name = "toml-generate-app"
    let scoped = ws.withWorkdir(tomlGenerateModulePath)
    let manifestPath = "/" + tomlGenerateModulePath + "/dagger-module.toml"
    let runtimeManifest = "name = \"toml-generate-app\"\nengineVersion = \"v1.0.0-0\"\n\n[runtime]\nsource = \"python\"\n"

    # A client is a member of the scope, not a dependency the manifest must
    # carry, so the static path takes one like the runtime path.
    let client = ws.moduleSource("/" + clientDepPath)
    let withClient = static.generateScope(scoped, isModule: true, name: name, clients: [client])
    assertContains(withClient.file(clientDepTargetPath).contents, "REF = \"" + clientRef(client, clientDepPath) + "\"", "a static entrypoint refused a client")
    assertContains(withClient.file("dagger-module.toml").contents, "./sdk/entrypoint", "a client took the module off the static path")

    let cached = static.generateScope(ws.withNewFile(manifestPath, "disableDefaultFunctionCaching = true\n" + runtimeManifest).withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).cwd rescue "raised"
    assert(cached == "raised", "disableDefaultFunctionCaching was dropped silently")

    # What only a runtime can honour keeps the module on its runtime, with the
    # setting kept as written and no entrypoint put in front of it.
    let included = static.generateScope(ws.withNewFile(manifestPath, "include = [\"src\"]\n" + runtimeManifest).withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: [])
      .file("/" + tomlGenerateModulePath + "/dagger-module.toml").contents
    assertContainsAll(included, ["include = [\"src\"]", "[runtime]", "source = \"" + sdkRuntimeSource + "\""])
    assertNotContains(included, "[entrypoint]", "a module of some files only was put on an entrypoint")

    let clients = static.generateScope(ws.withNewFile(manifestPath, "name = \"toml-generate-app\"\n\n[clients]\ngo = { path = \"gen\" }\n").withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: []).cwd rescue {
      err: Error => err.message
    }
    assertContainsAll(clients, ["[clients] table", "dagger.toml", "remove the table"])

    # Read as TOML: the builtin runtime quoted another way is still the one
    # this SDK wrote, not a runtime of the user's own.
    let quotedRuntime = static.generateScope(ws.withNewFile(manifestPath, "name = 'toml-generate-app'\n\n[runtime]\nsource = 'python'\n").withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: [])
      .file("/" + tomlGenerateModulePath + "/dagger-module.toml").contents rescue {
        err: Error => err.message
      }
    assertContains(quotedRuntime, "./sdk/entrypoint", "a single-quoted builtin runtime was refused on the static path: " + quotedRuntime)

    # A module rooted at its own directory is what an entrypoint manifest
    # assumes, so this one generates instead of being refused.
    let selfSourced = static.generateScope(ws.withNewFile(manifestPath, "source = \".\"\n" + runtimeManifest).withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: [])
      .file("/" + tomlGenerateModulePath + "/dagger-module.toml").contents
    assertContains(selfSourced, "[entrypoint]", "source = \".\" was refused on the static path")

    let sourcePath = "/" + tomlGenerateModulePath + "/src/toml_generate_app/__init__.py"
    let neverCached = "from dagger import function, object_type\n\n\n@object_type\nclass TomlGenerateApp:\n    @function(cache=\"never\")\n    def hello(self) -> str:\n        return \"hello\"\n"
    let fresh = static.generateScope(ws.withNewFile(sourcePath, neverCached).withWorkdir(tomlGenerateModulePath), isModule: true, name: name, clients: [])
      .file("/" + tomlGenerateModulePath + "/sdk/entrypoint/types.dang").contents
    assertContains(fresh, "withCachePolicy(FunctionCachePolicy.Never)", "a generated entrypoint dropped the cache policy: " + fresh)

    null
  }

  """
  The rendered types.dang type-checks and evaluates as a Dang module on this
  engine: the same builder calls the entrypoint makes at load time.
  """
  pub staticTypesLoadCheck(ws: Workspace!): Void @check {
    let generated = pythonSdk
      .generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    let types = generated.file("/" + tomlGenerateModulePath + "/sdk/entrypoint/types.dang")
    let tree = playgroundTree(ws).withFile(staticTypesModulePath + "/types.dang", types)
    let counted = cli(playgroundOf(tree), ["-m", staticTypesModulePath, "call", "count"]).stdout
    assert(counted.trimSpace == "1", "types.dang did not evaluate to the fixture's one type: " + counted)

    null
  }

  let resourcesRoot: String! = fixtureRoot + "/resources"
  let resourcesAppPath: String! = resourcesRoot + "/services/app"
  let resourcesProject: String! = "/" + resourcesAppPath + "/pyproject.toml"
  let greetSource: String! = "greet = { path = \"../../libs/greet\", editable = true }"
  let derivedSources: [String!]! = ["workspace.directory(\"../../libs/greet\", ", "workspace.directory(\"../../libs/text\", "]

  """
  The resources fixture with a uv.lock to lock again, so its build syncs the
  path sources from a lock as a pinned module does.
  """
  let resourcesSeeded(ws: Workspace!): Workspace! {
    ws.withNewFile("/" + resourcesAppPath + "/uv.lock", "version = 1\nrequires-python = \">=3.14\"\n")
  }

  let resourcesGenerated(sdk: PythonSdk!, ws: Workspace!): Workspace! {
    sdk.generateScope(ws.withWorkdir(resourcesAppPath), isModule: true, name: "resources-app", clients: []).withWorkdir(".")
  }

  let resourcesAttempt(sdk: PythonSdk!, ws: Workspace!): String! {
    resourcesGenerated(sdk, ws).file("/" + resourcesAppPath + "/sdk/entrypoint/main.dang").contents rescue {
      err: Error => err.message
    }
  }

  """
  The cases report together, so one run names every case that lost a path:
  empty when the generated entrypoint returns each directory from sources.
  """
  let derivedLost(what: String!, main: String!, dirs: [String!]!): String! {
    if (dirs.filter { dir => main.contains("workspace.directory(\"" + dir + "\", ") == false }.length == 0) {
      ""
    } else {
      what + ": " + main
    }
  }

  let withVendored(ws: Workspace!, dir: String!): Workspace! {
    let vendored = "/" + resourcesAppPath + "/" + dir
    ws
      .withNewFile(resourcesProject, ws.file(resourcesProject).contents
        .replace("\"greet\"]", "\"vendored-a\"]")
        .replace(greetSource, "vendored-a = { path = \"" + dir + "\" }"))
      .withNewFile(vendored + "/pyproject.toml",
        "[project]\nname = \"vendored-a\"\nversion = \"0.1.0\"\nrequires-python = \">=3.14\"\ndependencies = [\"greet\"]\n\n" +
        "[build-system]\nrequires = [\"uv_build>=0.8.4,<0.12.0\"]\nbuild-backend = \"uv_build\"\n\n" +
        "[tool.uv.sources]\ngreet = { path = \"../../../../libs/greet\" }\n")
      .withNewFile(vendored + "/src/vendored_a/__init__.py", "")
  }

  let assertDerived(main: String!, message: String!): Void {
    derivedSources.each { want => assertContains(main, want, message + ": " + main) }
    null
  }

  let withGreetSource(ws: Workspace!, source: String!): Workspace! {
    ws.withNewFile(resourcesProject, ws.file(resourcesProject).contents.replace(greetSource, source))
  }

  """
  A module whose path source sits outside its directory gets that path, and
  the path source's own, in its generated entrypoint, which builds from the
  module context. Generation writes nothing outside the module, and a second
  generation changes nothing. A library that is a workspace member is
  derived the same way, and a committed lock is locked again with the
  outside paths.
  """
  pub resourcesGenerateCheck(ws: Workspace!): Void @check {
    let seeded = resourcesSeeded(ws)
    let main = resourcesAttempt(pythonSdk, seeded)
    assertDerived(main, "the entrypoint does not return the outside library from sources")
    let generated = resourcesGenerated(pythonSdk, seeded)
    let manifest = generated.file("/" + resourcesAppPath + "/dagger-module.toml").contents
    assert(
      manifest == "name = \"resources-app\"\n\n[entrypoint]\n  kind = \"dang\"\n  source = \"./sdk/entrypoint\"\n",
      "unexpected manifest: " + manifest,
    )
    let changes = generated.changes(seeded)
    let outside = (changes.addedPaths + changes.modifiedPaths + changes.removedPaths)
      .filter { path => path.hasPrefix(resourcesAppPath + "/") == false }
    assert(outside.length == 0, "generation wrote outside the module: " + outside.join(", "))
    assertContainsAll(generated.file("/" + resourcesAppPath + "/uv.lock").contents, ["name = \"greet\"", "name = \"text\""])
    let again = pythonSdk
      .generateScope(generated.withWorkdir(resourcesAppPath), isModule: true, name: "resources-app", clients: [])
      .withWorkdir(".")
    assert(again.changes(generated).isEmpty, "a second generation changed a module with an outside library")

    let member = ws.withNewFile(resourcesProject, ws.file(resourcesProject).contents
      .replace("members = [\"sdk\", \"clients/core\"]", "members = [\"sdk\", \"clients/core\", \"../../libs/greet\"]")
      .replace(greetSource, "greet = { workspace = true }"))
    assertDerived(resourcesAttempt(pythonSdk, member), "a library that is a workspace member was not derived")

    let venvLibrary = "/" + resourcesRoot + "/libs/venv"
    let libraryInVenv = withGreetSource(ws, "greet = { path = \"../../libs/venv\", editable = true }")
      .withDirectory(venvLibrary, ws.directory("/" + resourcesRoot + "/libs/greet"))
    let memberInVenv = ws
      .withNewFile(resourcesProject, ws.file(resourcesProject).contents
        .replace("members = [\"sdk\", \"clients/core\"]", "members = [\"sdk\", \"clients/core\", \"../../libs/venv\"]")
        .replace(greetSource, "greet = { workspace = true }"))
      .withDirectory(venvLibrary, ws.directory("/" + resourcesRoot + "/libs/greet"))
    let venvModule = resourcesRoot + "/venv/app"
    let moduleInVenv = pythonSdk
      .generateScope(ws.withDirectory("/" + venvModule, ws.directory("/" + resourcesAppPath)).withWorkdir(venvModule), isModule: true, name: "resources-app", clients: [])
      .file("/" + venvModule + "/sdk/entrypoint/main.dang").contents rescue {
        err: Error => err.message
      }
    let besideJunk = ws
      .withNewFile("/" + resourcesAppPath + "/.venv/lib/junk/pyproject.toml", "[project\n")
      .withNewFile("/" + resourcesAppPath + "/node_modules/junk/pyproject.toml", "[project\n")
    let lost = [
      derivedLost("an outside library in libs/venv", resourcesAttempt(pythonSdk, libraryInVenv), ["../../libs/venv", "../../libs/text"]),
      derivedLost("a path source inside the module in vendor/venv", resourcesAttempt(pythonSdk, withVendored(ws, "vendor/venv")), ["../../libs/greet", "../../libs/text"]),
      derivedLost("a workspace member in libs/venv", resourcesAttempt(pythonSdk, memberInVenv), ["../../libs/venv", "../../libs/text"]),
      derivedLost("the module in venv/app", moduleInVenv, ["../../libs/greet", "../../libs/text"]),
      derivedLost("a module whose .venv and node_modules hold a pyproject.toml that does not parse", resourcesAttempt(pythonSdk, besideJunk), ["../../libs/greet", "../../libs/text"]),
    ].filter { said => said != "" }
    assert(lost.length == 0, "generation lost a path it derives:\n" + lost.join("\n"))

    assertDerived(resourcesAttempt(pythonSdk, resourcesSeeded(withVendored(ws, "vendor/a"))), "a locked module whose path source reads one outside was not generated")
    let byMarker = resourcesSeeded(withGreetSource(ws,
      "greet = [\n  { path = \"../../libs/greet\", marker = \"sys_platform == 'linux'\" },\n" +
      "  { path = \"../../libs/greet\", marker = \"sys_platform != 'linux'\" },\n]"))
    assertDerived(resourcesAttempt(pythonSdk, byMarker), "a locked module whose path source is written per marker was not generated")
    null
  }

  """
  A module with nothing outside its directory returns only that directory
  from its entrypoint's sources.
  """
  pub resourcesNoneCheck(ws: Workspace!): Void @check {
    let generated = pythonSdk
      .generateScope(ws.withWorkdir(tomlGenerateModulePath), isModule: true, name: "toml-generate-app", clients: [])
      .withWorkdir(".")
    let entrypoint = generated.directory("/" + tomlGenerateModulePath + "/sdk/entrypoint")
    let main = entrypoint.file("main.dang").contents
    assertContains(main, ".withDirectory(workspace.cwd, workspace.directory(\".\", ", "sources does not return the module directory: " + main)
    assert(main.split("workspace.directory(").length == 2, "sources of a module with nothing outside returns more than its directory: " + main)
    ["main.dang", "types.dang", "build.dang"].each { file =>
      assertNotContains(entrypoint.file(file).contents, "resources", file + " still names resources")
    }
    null
  }

  """
  Generation refuses an outside path it cannot load, before it writes
  anything, and names the file and the entry. Only the entrypoint generated
  into a module returns outside paths from its sources; a module on a runtime
  keeps the include of its manifest, so nothing is derived for it.
  """
  pub resourcesRefusalsCheck(ws: Workspace!): Void @check {
    assertResourcesRefused(ws, "greet = { path = \"/opt/greet\" }",
      "pyproject.toml: [tool.uv.sources] greet path \"/opt/greet\" is absolute; a module loads only files inside its workspace")
    assertResourcesRefused(ws, "greet = { path = \"../../../../../../../../../../greet\" }",
      "[tool.uv.sources] greet path \"../../../../../../../../../../greet\" leaves the workspace root")

    let remote = resourcesAttempt(pythonSdk(remoteEntrypoint: true), ws)
    assertContainsAll(remote, [
      "builds with files outside its directory (../../libs/greet, ../../libs/text)",
      "only the entrypoint this SDK generates into a module loads",
    ])
    let runtime = resourcesGenerated(pythonSdk(legacyRuntime: true), ws)
    assertContains(runtime.file("/" + resourcesAppPath + "/dagger-module.toml").contents, "[runtime]", "a module on a runtime was refused")
    assert(runtime.directory("/" + resourcesAppPath).exists("sdk/entrypoint") == false, "a module on a runtime got an entrypoint")

    assertResourcesRefused(ws, "greet = { path = \"../../libs/gone\" }",
      "builds with ../../libs/gone, which holds no file in the workspace")
    let wheel = "dist/greet-0.1.0-py3-none-any.whl"
    assertResourcesRefused(ws.withNewFile("/" + resourcesRoot + "/" + wheel, "wheel\n"), "greet = { path = \"../../" + wheel + "\" }",
      "builds with ../../" + wheel + ", which is a file; outside file sources, such as a wheel, are not supported")
    # The engine applies .gitignore files from the host only, so the ignored
    # fixture directory is committed rather than written as a workspace edit.
    assertResourcesRefused(ws, "greet = { path = \"../../ignored\" }",
      "builds with ../../ignored, which holds only files that .gitignore ignores")
    # A workspace edit cannot write a symlink, so libs/alias is committed too.
    let throughLink = "goes through the symlink " + resourcesRoot + "/libs/alias in the workspace; outside path sources through a symlink are not supported"
    assertResourcesRefused(ws, "greet = { path = \"../../libs/alias/src\" }", "builds with ../../libs/alias/src, which " + throughLink)
    assertResourcesRefused(ws, "greet = { path = \"../../libs/alias\" }", "builds with ../../libs/alias, which " + throughLink)
    null
  }

  """
  No lock is seeded: uv would lock the fixture first and refuse it in its own
  words.
  """
  let assertResourcesRefused(ws: Workspace!, source: String!, want: String!): Void {
    let said = resourcesAttempt(pythonSdk, withGreetSource(ws, source))
    assertContains(said, want, "generation did not refuse " + source + " with " + want + ": " + said)
    null
  }

  """
  A failed generation does not fail the exec, so a check can say what it
  printed.
  """
  let resourcesPlayground(ws: Workspace!): Container! {
    playgroundOf(playgroundTree(resourcesSeeded(ws))).withExec(
      ["dagger", "-y", "call", "python-sdk", "mod", "--path", resourcesAppPath, "--find-up=false", "generate"],
      experimentalPrivilegedNesting: true,
      expect: ReturnType.ANY,
    )
  }

  """
  A module with an outside library builds with it and with the library's own
  path source, and its API has no sources function. The call key follows
  the derived files: an edit of the transitive library gives a new key and a
  fresh result, an edit of a file nothing derives does not.
  """
  pub resourcesCallCheck(ws: Workspace!): Void @check {
    let generated = resourcesPlayground(ws)
    let said = generated.stdout + generated.stderr
    assert(generated.exitCode == 0, "generation through the CLI failed: " + said)
    assert(callResources(generated, "greeting") == "hello from greet and text", "the module did not build with its outside library")
    let functions = cli(generated, ["-m", resourcesAppPath, "functions"]).stdout
    assertContainsAll(functions, ["greeting", "call-digest"])
    assert(
      functions.split("\n").filter { line => (line.trimSpace.split(" ")[0] ?? "") == "sources" }.length == 0,
      "the module API has a sources function: " + functions,
    )

    let first = callResources(generated, "call-digest")
    let derived = generated.withNewFile(
      playgroundRoot + "/" + resourcesRoot + "/libs/text/src/text/__init__.py",
      "def word() -> str:\n    return \"edited text\"\n",
    )
    let afterDerived = callResources(derived, "call-digest")
    assert(afterDerived != first, "an edit of a derived library kept the call key: " + first)
    assert(callResources(derived, "greeting") == "hello from greet and edited text", "an edit of a derived library returned a stale result")
    let unrelated = derived.withNewFile(playgroundRoot + "/" + resourcesRoot + "/other/unrelated.txt", "edited\n")
    assert(callResources(unrelated, "call-digest") == afterDerived, "an edit of a file nothing derives changed the call key")
    null
  }

  let callResources(ctr: Container!, fn: String!): String! {
    cli(ctr, ["-m", resourcesAppPath, "call", fn]).stdout.trimSpace
  }

  """
  A module with an outside library runs from a Git repository: the engine
  reads the derived files at the commit, so the call finds the library there.
  """
  pub resourcesGitCallCheck(ws: Workspace!): Void @check {
    let generated = resourcesPlayground(ws)
    let said = generated.stdout + generated.stderr
    assert(generated.exitCode == 0, "generation through the CLI failed: " + said)
    let server = container
      .from("alpine:3.22")
      .withoutEntrypoint
      .withExec(["apk", "add", "--no-cache", "git", "git-daemon"])
      .withDirectory("/srv/repo", generated.directory(playgroundRoot + "/" + resourcesRoot))
      .withWorkdir("/srv/repo")
      .withExec(["git", "init", "-q", "-b", "main"])
      .withExec(["git", "add", "-A"])
      .withExec(["git", "-c", "user.name=e2e", "-c", "user.email=e2e@example.com", "commit", "-q", "-m", "resources fixture"])
      .withExec(["git", "clone", "-q", "--bare", ".", "/srv/repo.git"])
      .withExposedPort(9418)
      .withDefaultArgs(["git", "daemon", "--export-all", "--base-path=/srv", "/srv"])
      .asService
    let ref = "git://" + server.hostname + "/repo.git#main:services/app"
    let called = container
      .from(playgroundImage)
      .withoutEntrypoint
      .withServiceBinding(server.hostname, server)
      .withExec(["dagger", "-m", ref, "call", "greeting"], experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
    assert(
      called.exitCode == 0 and called.stdout.trimSpace == "hello from greet and text",
      "a module with an outside library did not run from Git:\n" + called.stdout + called.stderr,
    )
    null
  }

}
