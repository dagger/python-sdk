"""
Runtime for Python modules that commit their generated client library:
`dagger generate` vendors it, so nothing is generated here, and evaluating in
Dang costs no exec of its own.
"""
type PythonSdkRuntime {
  let runtimeExecutablePath: String! = "/runtime"

  """
  Container for executing the Python module runtime. introspectionJson is
  optional on purpose: the engine reads that as permission to skip codegen.
  """
  pub moduleRuntime(modSource: ModuleSource!, introspectionJson: File): Container! {
    let modName = modSource.moduleOriginalName
    let build = buildOf(modSource, modSource.naming)

    if (modSource.configExists == false or build.source.exists("pyproject.toml") == false) {
      raise "module \"" + modName + "\" has no source to trust; run `dagger generate` and commit the generated files"
    } else {
      # After the install, so those layers are shared with the static entrypoint.
      let installed = build.installed
        .withFile(runtimeExecutablePath, currentModule.source.file("runtime.py"), permissions: 493)
        .withEntrypoint([runtimeExecutablePath])

      if (modSource.sdk.debug == true) { installed.terminal } else { installed }
    }
  }

  """
  The module installed, its main object the one `naming` takes. Generation
  renders a module's static entrypoint in it, by the naming of the module it
  generates, which another source than the one it builds from may decide.
  """
  pub installed(modSource: ModuleSource!, naming: ModuleNaming!): Container! {
    buildOf(modSource, naming).installed
  }

  """
  The workspace members this runtime reads from a scope's pyproject.toml.
  Generation checks the file it writes with it.
  """
  pub scopeMembers(pyproject: File!): [String!]! {
    PythonModuleBuild().scopeMembers(pyproject)
  }

  let buildOf(modSource: ModuleSource!, naming: ModuleNaming!): PythonModuleBuild! {
    PythonModuleBuild(
      contextDir: modSource.contextDirectory,
      subPath: modSource.sourceSubpath,
      moduleName: modSource.moduleOriginalName,
      naming: naming,
    )
  }
}
