{
  "name": "python-sdk-runtime",
  "engineVersion": "v0.21.7",
  "sdk": {
    "source": "go"
  },
  "include": [
    "!**/.venv",
    "!**/__pycache__",
    "!**/*.pyc",
    "!sdk/.mypy_cache",
    "!sdk/.pytest_cache",
    "!sdk/.ruff_cache"
  ],
  "codegen": {
    "automaticGitignore": false
  }
}
